# Rust
/target
**/target
*.pdb
# Cargo.lock IS committed for the workspace app (root Cargo.lock)
# Plugin crates are standalone (not workspace members) — their locks stay local
plugins/*/Cargo.lock

# kn9t runtime state
~/.kn9t/
kn9t.db
kn9t.db-wal
kn9t.db-shm

# editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
# runtime logs — generic catch + the named offenders that have sat in the tree
# (F12 repo hygiene: kn9t-tui.log, custom-provider.log were 726 KB / 29 MB)
*.log
kn9t-tui.log
custom-provider.log

# python bytecode (plugins/kn9t-mcp)
__pycache__/
*.py[cod]

# node_modules is never committed, at any depth. The old rule only covered
# plugins/*/, which let a root node_modules/ from agent tooling go untracked
# but unignored (caught by a stray `git add -A`).
node_modules/

# typescript plugin build (plugins/kn9t-compactor)
plugins/*/dist/

# go plugin build output - 5 MB of binaries were committed.
# Build with, from plugins/kn9t-agents-md:
#   go build -o kn9t-agents-md .        (unix)
#   go build -o kn9t-agents-md.exe .    (windows)
plugins/kn9t-agents-md/kn9t-agents-md
plugins/kn9t-agents-md/kn9t-agents-md.exe
plugins/kn9t-agents-md/kn9t-agents-md-linux

# scratch
out.txt

# python venv (uv)
.venv/

# MCP tui-test captures (test artifacts)
artifacts/

# installed git hooks — generated by scripts/install-hooks.sh from
# scripts/pre-commit.hook, which IS tracked
/.githooks/
