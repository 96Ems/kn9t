   let value = match json_to_lua(lua, state) {\n143:             Ok(v) => v,\n144:             Err(e) => {\n145:                 crate::log!(\"plugin_ui {}: bad state: {}\", plugin, e);\n146:                 return;\n147:             }\n148:         };\n149:         if let Some(ui) = self.uis.get_mut(plugin) {\n150:             ui.state = value;\n151:         } else {\n152:             // State can arrive before the Lua chunk; keep it so the first\n153:             // render after registration already has data.\n154:             let env = match self.prepare_env(lua, plugin) {\n155:                 Ok(e) => e,\n156:                 Err(_) => return,\n157:             };\n158:             self.uis.insert(\n159:                 plugin.to_string(),\n160:                 PluginUi {\n161:                     env,\n162:                     state: value,\n163:                     error: Some(\"awaiting ui_register_lua\".to_string()),\n164:                 },\n165:             );\n166:         }\n167:     }\n168: \n169:     /// Remove a plugin's UI (plugin unloaded or session cleared).\n170:     pub fn remove(&mut self, plugin: &str) {\n171:         self.uis.remove(plugin);\n172:     }\n173: \n174:     pub fn clear(&mut self) {\n175:         self.uis.clear();\n176:     }\n177: \n178:     pub fn is_empty(&self) -> bool {\n179:         self.uis.is_empty()\n180:     }\n181: \n182:     /// Names of registered plugins, in stable order.\n183:     pub fn names(&self) -> Vec<&str> {\n184:         self.uis.keys().map(|s| s.as_str()).collect()\n185:     }\n186: \n187:     /// Call a plugin's `render(state)` and parse the widget tree.\n188:     ///\n189:     /// Returns `Err` with a displayable message when the plugin is broken, so\n190:     /// the caller can show the error in the space the view would have taken.\n191:     pub fn build(&self, lua: &Lua, plugin: &str) -> Result<Widget, String> {\n192:         let ui = self\n193:             .uis\n194:             .get(plugin)\n195:             .ok_or_else(|| format!(\"no UI registered for {plugin}\"))?;\n196: \n197:         if let Some(ref e) = ui.error {\n198:             return Err(e.clone());\n199:         }\n200: \n201:         let func: mlua::Function = ui\n202:             .env\n203:             .get(\"render\")\n204:             .map_err(|_| \"no render() function\".to_string())?;\n205: \n206:         let table: Table = func\n207:             .call(ui.state.clone())\n208:             .map_err(|e| format!(\"render() failed: {e}\"))?;\n209: \n210:         super::widgets::parse_widget(lua, &table).map_err(|e| format!(\"invalid widget: {e}\"))\n211:     }\n212: }\n213: \n214: /// Convert JSON into a Lua value.\n215: ///\n216: /// Objects become tables; arrays become 1-based sequences, which is what Lua\n217: /// code expects from `ipairs`.\n218: fn json_to_lua(lua: &Lua, v: &Json) -> LuaResult<LuaValue> {\n219:     Ok(match v {\n220:         Json::Null => LuaValue::Nil,\n221:         Json::Bool(b) => LuaValue::Boolean(*b),\n222:         Json::Number(n) => {\n223:             if let Some(i) = n.as_i64() {\n224:                 LuaValue::Integer(i)\n225:             } else {\n226:                 LuaValue::Number(n.as_f64().unwrap_or(0.0))\n227:             }\n228:         }\n229:         Json::String(s) => LuaValue::String(lua.create_string(s)?),",
