              "text": "1: //! The background poll loop, bootstrapped once per plugin process by the\n2: //! first `git_status` tool call — see `tool.rs` for why it has to work this\n3: //! way (no session-start hook, no `ctx` on `PluginHook::call`).\n4: \n5: use std::path::PathBuf;\n6: use std::sync::atomic::{AtomicBool, Ordering};\n7: use std::time::Duration;\n8: \n9: use kn9t_plugin_sdk::ctx::HostApiClient;\n10: \n11: use crate::git;\n12: use crate::ui;\n13: \n14: /// How often to re-poll while a session is open. Git status is cheap\n15: /// (`--porcelain=v2` on a typical repo is a few ms), so this can be short\n16: /// without meaningfully loading the machine.\n17: const POLL_INTERVAL: Duration = Duration::from_secs(3);\n18: \n19: /// Start the background poller for one repository, if one is not already\n20: /// running for it. Returns immediately either way — the actual polling\n21: /// happens on a spawned thread.\n22: ///\n23: /// Guarded per-`cwd` (not globally) so a host juggling multiple sessions in\n24: /// different repositories gets one poller each, not one poller pinned to\n25: /// whichever repo happened to bootstrap first.\n26: pub fn ensure_started(host: HostApiClient, cwd: PathBuf) {\n27:     use std::collections::HashSet;\n28:     use std::sync::Mutex;\n29:     static STARTED: Mutex<Option<HashSet<PathBuf>>> = Mutex::new(None);\n30: \n31:     let mut guard = STARTED.lock().unwrap();\n32:     let set = guard.get_or_insert_with(HashSet::new);\n33:     if !set.insert(cwd.clone()) {\n34:         return; // Already running for this cwd.\n35:     }\n36:     drop(guard);\n37: \n38:     std::thread::spawn(move || run(host, cwd));\n39: }\n40: \n41: fn run(host: HostApiClient, cwd: PathBuf) {\n42:     // Registered once per (host process, repo) pair; ui_register_lua on the\n43:     // host side replaces any previous registration for this plugin, so\n44:     // re-sending on every poll would be wasted work, not incorrect — this\n45:     // just avoids that waste.\n46:     let registered = AtomicBool::new(false);\n47: \n48:     // The `host` client is bound to the session id of the tool call that\n49:     // bootstrapped this thread (HostApiClient auto-injects it). There is no\n50:     // \"session ended\" signal available to this thread — the plugin protocol\n51:     // has no session-teardown hook either — so this stops itself instead on\n52:     // repeated push failure, which is what a closed/gone session looks like\n53:     // from here (`ui_set_state` starts erroring once the session is gone).\n54:     // Known limitation: a session that ends cleanly still costs up to\n55:     // MAX_CONSECUTIVE_FAILURES * POLL_INTERVAL of pointless polling before\n56:     // this notices. Acceptable for a first version; a real fix needs a\n57:     // session-lifecycle signal the protocol does not currently provide.\n58:     const MAX_CONSECUTIVE_FAILURES: u32 = 10;\n59:     let mut consecutive_failures = 0u32;\n60: \n61:     loop {\n62:         if !registered.load(Ordering::Relaxed) {\n63:             if host\n64:                 .call(\n65:                     \"ui_register_lua\",\n66:                     serde_json::json!({ \"source\": ui::LUA_SOURCE }),\n67:                 )\n68:                 .is_ok()\n69:             {\n70:                 registered.store(true, Ordering::Relaxed);\n71:             }\n72:         }\n73: \n74:         let state = git::collect(&cwd);\n75:         let payload = ui::state_to_json(state.as_ref());\n76:         match host.call(\"ui_set_state\", serde_json::json!({ \"state\": payload })) {\n77:             Ok(_) => consecutive_failures = 0,\n78:             Err(_) => {\n79:                 consecutive_failures += 1;\n80:                 if consecutive_failures >= MAX_CONSECUTIVE_FAILURES {\n81:                     return;\n82:                 }\n83:             }\n84:         }\n85: \n86:         std::thread::sleep(POLL_INTERVAL);\n87:     }\n88: }",
