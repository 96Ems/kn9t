-> Lua handler -> queued builtin.\n470:         let lua = lua_with_api();\n471:         let mut reg = KeymapRegistry::new();\n472: \n473:         lua.load(r#\"kn9t.map(\"C-g\", function() kn9t.action(\"scroll_top\") end)\"#)\n474:             .exec()\n475:             .unwrap();\n476:         drain_pending_maps(&lua, &mut reg).unwrap();\n477: \n478:         assert!(reg.dispatch(&lua, \"C-g\"));\n479:         assert_eq!(\n480:             drain_pending_actions(&lua),\n481:             vec![(\"scroll_top\".to_string(), None)]\n482:         );\n483:     }\n484: \n485:     /// `kn9t.invalidate()` is the escape hatch for the render cache in\n486:     /// `lua::LuaRuntime::build_ui_outcome`: it must actually move the counter\n487:     /// Rust reads, or a toggle flip would redraw stale for up to 9 frames.\n488:     #[test]\n489:     fn invalidate_bumps_the_epoch_each_call() {\n490:         let lua = lua_with_api();\n491:         assert_eq!(\n492:             read_epoch(&lua),\n493:             0,\n494:             \"starts at zero, not nil-as-zero by luck\"\n495:         );\n496: \n497:         lua.load(\"kn9t.invalidate()\").exec().unwrap();\n498:         assert_eq!(read_epoch(&lua), 1);\n499: \n500:         lua.load(\"kn9t.invalidate(); kn9t.invalidate()\")\n501:             .exec()\n502:             .unwrap();\n503:         assert_eq!(read_epoch(&lua), 3);\n504:     }\n505: }",
