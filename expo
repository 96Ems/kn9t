              "text": "1: //! Lua keymaps — key strings bound to Lua callbacks.\n2: //!\n3: //! Lua registers handlers with `kn9t.map(\"C-t\", function() ... end)`.\n4: //! Keys are matched *before* the built-in Rust actions, so a Lua map can\n5: //! override any default binding. A handler returning `false` falls through\n6: //! to the Rust action, which lets Lua extend behaviour without replacing it.\n7: //!\n8: //! Key syntax matches `keybind::parse_key`: `\"C-t\"`, `\"A-Enter\"`, `\"F5\"`.\n9: \n10: use std::collections::HashMap;\n11: \n12: use mlua::{Function, Lua, RegistryKey, Result as LuaResult, Table, Value};\n13: \n14: /// Registry of Lua key handlers, keyed by canonical key string.\n15: #[derive(Debug, Default)]\n16: pub struct KeymapRegistry {\n17:     maps: HashMap<String, RegistryKey>,\n18: }\n19: \n20: impl KeymapRegistry {\n21:     pub fn new() -> Self {\n22:         Self::default()\n23:     }\n24: \n25:     pub fn len(&self) -> usize {\n26:         self.maps.len()\n27:     }\n28: \n29:     pub fn is_empty(&self) -> bool {\n30:         self.maps.is_empty()\n31:     }\n32: \n33:     /// Whether any Lua handler is bound to `key`.\n34:     pub fn has(&self, key: &str) -> bool {\n35:         self.maps.contains_key(key)\n36:     }\n37: \n38:     /// All bound keys (for help/which-key display).\n39:     pub fn keys(&self) -> Vec<&str> {\n40:         self.maps.keys().map(|s| s.as_str()).collect()\n41:     }\n42: \n43:     /// Bind `key` to a Lua function, replacing any previous binding.\n44:     pub fn insert(&mut self, key: String, func_key: RegistryKey) {\n45:         self.maps.insert(key, func_key);\n46:     }\n47: \n48:     pub fn remove(&mut self, key: &str) {\n49:         self.maps.remove(key);\n50:     }\n51: \n52:     /// Invoke the handler for `key`.\n53:     ///\n54:     /// Returns `true` when the key was consumed. A handler that returns `false`\n55:     /// (or errors) is treated as *not* consumed so Rust still runs its action.\n56:     pub fn dispatch(&self, lua: &Lua, key: &str) -> bool {\n57:         let Some(reg_key) = self.maps.get(key) else {\n58:             return false;\n59:         };\n60:         let Ok(func) = lua.registry_value::<Function>(reg_key) else {\n61:             return false;\n62:         };\n63:         match func.call::<Value>(()) {\n64:             // Explicit `false` means \"let Rust handle it too\".\n65:             Ok(Value::Boolean(false)) => false,\n66:             Ok(_) => true,\n67:             Err(e) => {\n68:                 crate::log!(\"Lua keymap '{}' error: {}\", key, e);\n69:                 false\n70:             }\n71:         }\n72:     }\n73: }\n74: \n75: /// Install `kn9t.map` / `kn9t.unmap` into the Lua environment.\n76: ///\n77: /// Registrations are queued in `kn9t._pending_maps` and drained by\n78: /// [`drain_pending_maps`], mirroring how panels are registered.\n79: pub fn install_keymap_api(lua: &Lua) -> LuaResult<()> {\n80:     let globals = lua.globals();\n81:     let kn9t: Table = globals\n82:         .get(\"kn9t\")\n83:         .unwrap_or_else(|_| lua.create_table().unwrap());\n84: \n85:     let pending = lua.create_table()?;\n86:     kn9t.set(\"_pending_maps\", pending)?;\n87: \n88:     let map_fn = lua.create_function(|lua, (key, func): (String, Function)| {\n89:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n90:         let pending: Table = kn9t.get(\"_pending_maps\")?;\n91:         pending.set(key, func)?;\n92:         Ok(())\n93:     })?;\n94:     kn9t.set(\"map\", map_fn)?;\n95: \n96:     let unmap_fn = lua.create_function(|lua, key: String| {\n97:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n98:         let pending: Table = kn9t.get(\"_pending_maps\")?;\n99:         // false is the tombstone: distinguishes \"unbind\" from \"never mentioned\".\n100:         pending.set(key, false)?;\n101:         Ok(())\n102:     })?;\n103:     kn9t.set(\"unmap\", unmap_fn)?;\n104: \n105:     // Queue of built-in actions requested from Lua, drained by the app loop.\n106:     let actions = lua.create_table()?;\n107:     kn9t.set(\"_pending_actions\", actions)?;\n108: \n109:     // kn9t.action(\"scroll_top\") or kn9t.action(\"switch_session\", id) — run a\n110:     // built-in action from a Lua handler. Queued rather than immediate: Lua\n111:     // callbacks have no access to &mut App.\n112:     //\n113:     // `arg` is optional and ignored by every action except ones that document\n114:     // needing it (currently just `switch_session`); this keeps one dispatch\n115:     // path instead of a second function for the one action that takes data.\n116:     let action_fn = lua.create_function(|lua, (name, arg): (String, Option<String>)| {\n117:         if !crate::keybind::is_valid_action_name(&name) {\n118:             crate::log!(\"Lua: unknown action '{}'\", name);\n119:             return Ok(false);\n120:         }\n121:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n122:         let queue: Table = kn9t.get(\"_pending_actions\")?;\n123:         let entry = lua.create_table()?;\n124:         entry.set(\"name\", name)?;\n125:         if let Some(a) = arg {\n126:             entry.set(\"arg\", a)?;\n127:         }\n128:         queue.push(entry)?;\n129:         Ok(true)\n130:     })?;\n131:     kn9t.set(\"action\", action_fn)?;\n132: \n133:     // `kn9t.invalidate()` — force a UI rebuild next frame even though nothing\n134:     // Rust can see changed. `render_ui`'s cache is fingerprinted from data Rust\n135:     // already has (message/tool counts, scroll, cost, ...); it cannot see a\n136:     // Lua-local toggle like `SHOW.sidebar` flip. A keymap handler that mutates\n137:     // such state must call this, or the next redraw reuses the stale tree.\n138:     let invalidate_fn = lua.create_function(|lua, ()| {\n139:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n140:         let epoch: i64 = kn9t.get(\"_epoch\").unwrap_or(0);\n141:         kn9t.set(\"_epoch\", epoch + 1)?;\n142:         Ok(())\n143:     })?;\n144:     kn9t.set(\"invalidate\", invalidate_fn)?;\n145: \n146:     globals.set(\"kn9t\", kn9t)?;\n147:     Ok(())\n148: }\n149: \n150: /// Drain queued `kn9t.action(...)` calls, in call order.\n151: ///\n152: /// Each entry is `(action_name, optional_arg)`; the arg is `None` for the\n153: /// ~44 param-less actions and `Some(id)` for e.g. `switch_session`.\n154: pub fn drain_pending_actions(lua: &Lua) -> Vec<(String, Option<String>)> {\n155:     let Ok(kn9t) = lua.globals().get::<Table>(\"kn9t\") else {\n156:         return Vec::new();\n157:     };\n158:     let Ok(queue) = kn9t.get::<Table>(\"_pending_actions\") else {\n159:         return Vec::new();\n160:     };\n161: \n162:     let mut out = Vec::new();\n163:     let len = queue.len().unwrap_or(0);\n164:     for i in 1..=len {\n165:         if let Ok(entry) = queue.get::<Table>(i) {\n166:             if let Ok(name) = entry.get::<String>(\"name\") {\n167:                 let arg = entry.get::<String>(\"arg\").ok();\n168:                 out.push((name, arg));\n169:             }\n170:         }\n171:     }\n172:     for i in 1..=len {\n173:         let _ = queue.set(i, Value::Nil);\n174:     }\n175:     out\n176: }\n177: \n178: /// Read the `kn9t.invalidate()` epoch counter.\n179: ///\n180: /// A plain integer read every frame — cheap enough to fold into the UI\n181: /// fingerprint unconditionally rather than only checking it lazily.\n182: pub fn read_epoch(lua: &Lua) -> u64 {\n183:     let Ok(kn9t) = lua.globals().get::<Table>(\"kn9t\") else {\n184:         return 0;\n185:     };\n186:     kn9t.get::<i64>(\"_epoch\").unwrap_or(0).max(0) as u64\n187: }\n188: \n189: /// Apply queued `kn9t.map` / `kn9t.unmap` calls to `registry`.\n190: ///\n191: /// Returns the number of bindings applied (added or removed).\n192: pub fn drain_pending_maps(lua: &Lua, registry: &mut KeymapRegistry) -> LuaResult<usize> {\n193:     let globals = lua.globals();\n194:     let Ok(kn9t) = globals.get::<Table>(\"kn9t\") else {\n195:         return Ok(0);\n196:     };\n197:     let Ok(pending) = kn9t.get::<Table>(\"_pending_maps\") else {\n198:         return Ok(0);\n199:     };\n200: \n201:     let mut applied = 0;\n202:     let mut seen: Vec<String> = Vec::new();\n203: \n204:     for pair in pending.pairs::<String, Value>() {\n205:         let (key, value) = pair?;\n206:         seen.push(key.clone());\n207: \n208:         match value {\n209:             Value::Function(f) => {\n210:                 // Reject keys we could never match, so typos surface in the log\n211:                 // instead of silently doing nothing.\n212:                 if !crate::keybind::is_valid_key_string(&key) {\n213:                     crate::log!(\"Lua keymap: ignoring unparseable key '{}'\", key);\n214:                     continue;\n215:                 }\n216:                 registry.insert(key, lua.create_registry_value(f)?);\n217:                 applied += 1;\n218:             }\n219:             Value::Boolean(false) => {\n220:                 registry.remove(&key);\n221:                 applied += 1;\n222:             }\n223:             _ => {\n224:                 crate::log!(\"Lua keymap '{}': expected function, got other value\", key);\n225:             }\n226:         }\n227:     }\n228: \n229:     for key in seen {\n230:         pending.set(key, Value::Nil)?;\n231:     }\n232: \n233:     Ok(applied)\n234: }\n235: \n236: #[cfg(test)]\n237: mod tests {\n238:     use super::*;\n239: \n240:     fn lua_with_api() -> Lua {\n241:         let lua = Lua::new();\n242:         install_keymap_api(&lua).unwrap();\n243:         lua\n244:     }\n245: \n246:     #[test]\n247:     fn map_registers_a_handler() {\n248:         let lua = lua_with_api();\n249:         let mut reg = KeymapRegistry::new();\n250: \n251:         lua.load(r#\"kn9t.map(\"C-t\", function() return true end)\"#)\n252:             .exec()\n253:             .unwrap();\n254:         assert_eq!(drain_pending_maps(&lua, &mut reg).unwrap(), 1);\n255: \n256:         assert!(reg.has(\"C-t\"));\n257:         assert!(reg.dispatch(&lua, \"C-t\"), \"handler consumes the key\");\n258:     }\n259: \n260:     #[test]\n261:     fn unmapped_key_is_not_consumed() {\n262:         let lua = lua_with_api();\n263:         let reg = KeymapRegistry::new();\n264:         assert!(!reg.dispatch(&lua, \"C-x\"));\n265:     }\n266: \n267:     #[test]\n268:     fn returning_false_falls_through_to_rust() {\n269:         // This is the \"extend, don't replace\" path: Lua sees the key, then Rust\n270:         // still runs its own action.\n271:         let lua = lua_with_api();\n272:         let mut reg = KeymapRegistry::new();\n273: \n274:         lua.load(\n275:             r#\"\n276:             fired = false\n277:             kn9t.map(\"C-b\", function() fired = true; return false end)\n278:         \"#,\n279:         )\n280:         .exec()\n281:         .unwrap();\n282:         drain_pending_maps(&lua, &mut reg).unwrap();\n283: \n284:         assert!(!reg.dispatch(&lua, \"C-b\"), \"not consumed\");\n285:         assert!(\n286:             lua.globals().get::<bool>(\"fired\").unwrap(),\n287:             \"handler still ran\"\n288:         );\n289:     }\n290: \n291:     #[test]\n292:     fn handler_error_does_not_consume_or_panic() {\n293:         let lua = lua_with_api();\n294:         let mut reg = KeymapRegistry::new();\n295: \n296:         lua.load(r#\"kn9t.map(\"C-e\", function() error(\"boom\") end)\"#)\n297:             .exec()\n298:             .unwrap();\n299:         drain_pending_maps(&lua, &mut reg).unwrap();\n300: \n301:         // A broken handler must not swallow the key, or the TUI would feel dead.\n302:         assert!(!reg.dispatch(&lua, \"C-e\"));\n303:     }\n304: \n305:     #[test]\n306:     fn unmap_removes_a_binding() {\n307:         let lua = lua_with_api();\n308:         let mut reg = KeymapRegistry::new();\n309: \n310:         lua.load(r#\"kn9t.map(\"C-t\", function() end)\"#)\n311:             .exec()\n312:             .unwrap();\n313:         drain_pending_maps(&lua, &mut reg).unwrap();\n314:         assert!(reg.has(\"C-t\"));\n315: \n316:         lua.load(r#\"kn9t.unmap(\"C-t\")\"#).exec().unwrap();\n317:         drain_pending_maps(&lua, &mut reg).unwrap();\n318:         assert!(!reg.has(\"C-t\"), \"binding removed\");\n319:     }\n320: \n321:     #[test]\n322:     fn rebinding_replaces_the_previous_handler() {\n323:         let lua = lua_with_api();\n324:         let mut reg = KeymapRegistry::new();\n325: \n326:         lua.load(r#\"kn9t.map(\"C-t\", function() return true end)\"#)\n327:             .exec()\n328:             .unwrap();\n329:         drain_pending_maps(&lua, &mut reg).unwrap();\n330: \n331:         // Hot-reload rebinds the same key: must not accumulate handlers.\n332:         lua.load(r#\"kn9t.map(\"C-t\", function() return false end)\"#)\n333:             .exec()\n334:             .unwrap();\n335:         drain_pending_maps(&lua, &mut reg).unwrap();\n336: \n337:         assert_eq!(reg.len(), 1);\n338:         assert!(!reg.dispatch(&lua, \"C-t\"), \"new handler is the live one\");\n339:     }\n340: \n341:     #[test]\n342:     fn unparseable_keys_are_rejected() {\n343:         let lua = lua_with_api();\n344:         let mut reg = KeymapRegistry::new();\n345: \n346:         lua.load(r#\"kn9t.map(\"NotAKey\", function() end)\"#)\n347:             .exec()\n348:             .unwrap();\n349:         drain_pending_maps(&lua, &mut reg).unwrap();\n350: \n351:         assert!(reg.is_empty(), \"typo must not create a dead binding\");\n352:     }\n353: \n354:     #[test]\n355:     fn draining_twice_does_not_reapply() {\n356:         let lua = lua_with_api();\n357:         let mut reg = KeymapRegistry::new();\n358: \n359:         lua.load(r#\"kn9t.map(\"F5\", function() end)\"#)\n360:             .exec()\n361:             .unwrap();\n362:         assert_eq!(drain_pending_maps(&lua, &mut reg).unwrap(), 1);\n363:         assert_eq!(\n364:             drain_pending_maps(&lua, &mut reg).unwrap(),\n365:             0,\n366:             \"queue is consumed\"\n367:         );\n368:         assert!(reg.has(\"F5\"), \"binding survives the second drain\");\n369:     }\n370: \n371:     #[test]\n372:     fn action_queues_builtin_by_name() {\n373:         let lua = lua_with_api();\n374:         lua.load(r#\"kn9t.action(\"scroll_top\")\"#).exec().unwrap();\n375:         assert_eq!(\n376:             drain_pending_actions(&lua),\n377:             vec![(\"scroll_top\".to_string(), None)]\n378:         );\n379:     }\n380: \n381:     #[test]\n382:     fn action_rejects_unknown_names() {\n383:         let lua = lua_with_api();\n384:         // Returns false to Lua *and* queues nothing.\n385:         let ok: bool = lua.load(r#\"return kn9t.action(\"nope\")\"#).eval().unwrap();\n386:         assert!(!ok);\n387:         assert!(drain_pending_actions(&lua).is_empty());\n388:     }\n389: \n390:     #[test]\n391:     fn actions_preserve_call_order_and_drain_once() {\n392:         let lua = lua_with_api();\n393:         lua.load(\n394:             r#\"\n395:             kn9t.action(\"scroll_top\")\n396:             kn9t.action(\"open_models\")\n397:             kn9t.action(\"scroll_bottom\")\n398:         \"#,\n399:         )\n400:         .exec()\n401:         .unwrap();\n402: \n403:         assert_eq!(\n404:             drain_pending_actions(&lua),\n405:             vec![\n406:                 (\"scroll_top\".to_string(), None),\n407:                 (\"open_models\".to_string(), None),\n408:                 (\"scroll_bottom\".to_string(), None),\n409:             ]\n410:         );\n411:         assert!(drain_pending_actions(&lua).is_empty(), \"queue is emptied\");\n412:     }\n413: \n414:     /// `switch_session` is the first action that carries data. It must survive\n415:     /// the queue round-trip attached to the right call, not just be present\n416:     /// somewhere in the drained list.\n417:     #[test]\n418:     fn action_with_argument_round_trips() {\n419:         let lua = lua_with_api();\n420:         lua.load(\n421:             r#\"\n422:             kn9t.action(\"scroll_top\")\n423:             kn9t.action(\"switch_session\", \"sess-42\")\n424:         \"#,\n425:         )\n426:         .exec()\n427:         .unwrap();\n428: \n429:         assert_eq!(\n430:             drain_pending_actions(&lua),\n431:             vec![\n432:                 (\"scroll_top\".to_string(), None),\n433:                 (\"switch_session\".to_string(), Some(\"sess-42\".to_string())),\n434:             ]\n435:         );\n436:     }\n437: \n438:     /// An action name must be rejected unless `execute_action` really handles it.\n439:     /// `toggle_right` used to pass validation and then do nothing, so a config\n440:     /// binding it looked correct and silently failed.\n441:     #[test]\n442:     fn every_accepted_action_name_is_dispatchable() {\n443:         let lua = lua_with_api();\n444:         // Accepted names round-trip to a real Action.\n445:         for name in [\n446:             \"scroll_top\",\n447:             \"diff_next_hunk\",\n448:             \"open_tools\",\n449:             \"session_picker\",\n450:             \"refresh_tools\",\n451:             \"switch_session\",\n452:         ] {\n453:             assert!(\n454:                 crate::keybind::parse_action(name).is_some(),\n455:                 \"{name} must map to an Action\"\n456:             );\n457:         }\n458:         // A removed action is rejected at registration time, not silently queued.\n459:         let ok: bool = lua\n460:             .load(r#\"return kn9t.action(\"toggle_right\")\"#)\n461:             .eval()\n462:             .unwrap();\n463:         assert!(!ok, \"an unhandled action name must be refused\");\n464:         assert!(drain_pending_actions(&lua).is_empty());\n465:     }\n466: \n467:     #[test]\n468:     fn action_from_inside_a_keymap_handler() {\n469:         // The real path: key ->