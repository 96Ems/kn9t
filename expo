                "text": "1: //! Plugin-supplied Lua UI.\n2: //!\n3: //! A plugin that wants to draw in the TUI ships Lua source, not a fixed\n4: //! placeholder vocabulary. It sends the source once (`ui_register_lua`), then\n5: //! pushes state updates (`ui_set_state`) which are cheap JSON.\n6: //!\n7: //! # Isolation\n8: //!\n9: //! Each plugin's chunk runs with its own environment table, so plugins cannot\n10: //! see or clobber each other's definitions — or the user's `~/.kn9t/tui.lua`.\n11: //! This is collision avoidance, not a security boundary: plugins are native\n12: //! executables (`Command::new`) and already hold full OS privileges, so\n13: //! restricting their Lua would protect nothing.\n14: //!\n15: //! What the isolation *does* guarantee is that a buggy plugin degrades to a\n16: //! visible error in its own panel instead of corrupting unrelated UI.\n17: //!\n18: //! # Who decides placement\n19: //!\n20: //! A plugin returns a widget tree; it does not choose where that tree lands.\n21: //! `kn9t.plugin_views()` lists what is available and the user's `tui.lua`\n22: //! decides whether and where to draw each one. Plugins cannot seize screen\n23: //! space or hide the transcript.\n24: \n25: use std::collections::BTreeMap;\n26: \n27: use mlua::{Lua, Result as LuaResult, Table, Value as LuaValue};\n28: use serde_json::Value as Json;\n29: \n30: use super::widgets::Widget;\n31: \n32: /// One plugin's registered UI.\n33: struct PluginUi {\n34:     /// The plugin's private environment (holds its `render` function).\n35:     env: Table,\n36:     /// Latest state pushed by the plugin, as a Lua value.\n37:     state: LuaValue,\n38:     /// Set when the chunk failed to load or `render` errored. Shown in place of\n39:     /// the view so failures are visible rather than silent.\n40:     error: Option<String>,\n41: }\n42: \n43: /// All plugin-supplied UIs, keyed by `plugin` name.\n44: ///\n45: /// `BTreeMap` so iteration order is stable: panels must not reshuffle between\n46: /// frames just because of hash ordering.\n47: #[derive(Default)]\n48: pub struct PluginUiRegistry {\n49:     uis: BTreeMap<String, PluginUi>,\n50: }\n51: \n52: impl PluginUiRegistry {\n53:     pub fn new() -> Self {\n54:         Self::default()\n55:     }\n56: \n57:     /// Register (or replace) a plugin's Lua UI.\n58:     ///\n59:     /// A load failure is recorded rather than returned: one broken plugin must\n60:     /// not abort the frame or block other plugins from registering.\n61:     pub fn register(&mut self, lua: &Lua, plugin: &str, source: &str) {\n62:         let env = match self.prepare_env(lua, plugin) {\n63:             Ok(e) => e,\n64:             Err(e) => {\n65:                 crate::log!(\"plugin_ui {}: env setup failed: {}\", plugin, e);\n66:                 return;\n67:             }\n68:         };\n69: \n70:         let chunk_name = format!(\"@plugin:{plugin}\");\n71:         let error = match lua\n72:             .load(source)\n73:             .set_name(chunk_name)\n74:             .set_environment(env.clone())\n75:             .exec()\n76:         {\n77:             Ok(()) => {\n78:                 // A chunk that loads but defines no `render` is a plugin bug;\n79:                 // report it now rather than drawing nothing every frame.\n80:                 match env.get::<Option<mlua::Function>>(\"render\") {\n81:                     Ok(Some(_)) => None,\n82:                     _ => Some(\"no render() function defined\".to_string()),\n83:                 }\n84:             }\n85:             Err(e) => {\n86:                 crate::log!(\"plugin_ui {}: load failed: {}\", plugin, e);\n87:                 Some(format!(\"{e}\"))\n88:             }\n89:         };\n90: \n91:         // Preserve any state already pushed, so registration order and state\n92:         // order do not have to match.\n93:         let state = self\n94:             .uis\n95:             .get(plugin)\n96:             .map(|u| u.state.clone())\n97:             .unwrap_or(LuaValue::Nil);\n98: \n99:         self.uis\n100:             .insert(plugin.to_string(), PluginUi { env, state, error });\n101:     }\n102: \n103:     /// Build the private environment a plugin's chunk runs in.\n104:     ///\n105:     /// It gets the standard library it needs for formatting, plus `kn9t.log`,\n106:     /// and nothing that would let it reach the host UI's globals.\n107:     fn prepare_env(&self, lua: &Lua, plugin: &str) -> LuaResult<Table> {\n108:         let env = lua.create_table()?;\n109:         let globals = lua.globals();\n110: \n111:         // Pure helpers only. Deliberately no `kn9t` table from globals: a\n112:         // plugin must not read session state or call HTTP through the UI layer.\n113:         for name in [\n114:             \"assert\", \"error\", \"ipairs\", \"math\", \"next\", \"pairs\", \"pcall\", \"select\", \"string\",\n115:             \"table\", \"tonumber\", \"tostring\", \"type\", \"unpack\", \"xpcall\",\n116:         ] {\n117:             if let Ok(v) = globals.get::<LuaValue>(name) {\n118:                 env.set(name, v)?;\n119:             }\n120:         }",
