500: | `\"text\"` | `text: string` |\n501: | `\"tool_call\"` | `id: string`, `name: string`, `args_json: string` |\n502: | `\"tool_result\"` | `id: string`, `content: Content[]`, `is_error: bool` |\n503: | `\"thinking\"` | `text: string` |\n504: | `\"image\"` | `sha256: string`, `mime: string` |\n505: \n506: ### Tokens\n507: \n508: ```json\n509: { \"input\": u64, \"output\": u64, \"cache_read\": u64, \"cache_write\": u64, \"reasoning\": u64 }\n510: ```\n511: \n512: ### ModelRef\n513: \n514: ```json\n515: { \"provider\": \"string\", \"id\": \"string\" }\n516: ```\n517: \"#;",
