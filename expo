                "text": "1: //! Serializes `git::GitState` to JSON and defines the Lua `render(state)`\n2: //! sent once via `ui_register_lua`.\n3: //!\n4: //! Kept intentionally small: colours/layout are minimal here on purpose,\n5: //! since `~/.kn9t/tui/30_sidebar_left.lua` is the thing actually deciding\n6: //! how (and whether) this plugin's view is framed — this is the content, not\n7: //! the chrome.\n8: \n9: use crate::git::GitState;\n10: \n11: /// JSON pushed via `ui_set_state`. `null` (not an empty object) when `cwd`\n12: /// is not a git repository, so the Lua side can render a distinct message\n13: /// instead of an empty-but-misleadingly-\"clean\" status.\n14: pub fn state_to_json(state: Option<&GitState>) -> serde_json::Value {\n15:     match state {\n16:         None => serde_json::Value::Null,\n17:         Some(s) => serde_json::json!({\n18:             \"branch\": s.branch,\n19:             \"ahead\": s.ahead,\n20:             \"behind\": s.behind,\n21:             \"changes\": s.changes.iter().map(|c| serde_json::json!({\n22:                 \"status\": c.status,\n23:                 \"path\": c.path,\n24:             })).collect::<Vec<_>>(),\n25:             \"recent\": s.recent.iter().map(|l| serde_json::json!({\n26:                 \"sha\": l.sha,\n27:                 \"subject\": l.subject,\n28:             })).collect::<Vec<_>>(),\n29:         }),\n30:     }\n31: }\n32: \n33: /// Lua defining `render(state)`, sent once via `ui_register_lua` (256 KB cap\n34: /// — this is well under it). `state` is exactly what `state_to_json` above\n35: /// produced, round-tripped through the host's JSON<->Lua conversion.\n36: pub const LUA_SOURCE: &str = r#\"\n37: function render(state)\n38:     if state == nil then\n39:         return {\n40:             type = \"text\",\n41:             content = \"(not a git repository)\",\n42:             fg = \"darkgray\",\n43:         }\n44:     end\n45: \n46:     local lines = {}\n47:     local branch = state.branch or \"?\"\n48:     local ab = \"\"\n49:     if (state.ahead or 0) > 0 then ab = ab .. \" +\" .. state.ahead end\n50:     if (state.behind or 0) > 0 then ab = ab .. \" -\" .. state.behind end\n51:     table.insert(lines, { text = branch .. ab, fg = \"cyan\", bold = true })\n52: \n53:     local changes = state.changes or {}\n54:     if #changes == 0 then\n55:         table.insert(lines, { text = \"(clean)\", fg = \"darkgray\" })\n56:     else\n57:         for _, c in ipairs(changes) do\n58:             local col = \"yellow\"\n59:             if c.status == \"?\" then col = \"green\"\n60:             elseif c.status == \"D\" then col = \"lightred\"\n61:             end\n62:             table.insert(lines, { text = c.status .. \" \" .. c.path, fg = col })\n63:         end\n64:     end\n65: \n66:     table.insert(lines, { text = \"\", fg = \"darkgray\" })\n67:     table.insert(lines, { text = \"recent:\", fg = \"darkgray\" })\n68:     local recent = state.recent or {}\n69:     for _, l in ipairs(recent) do\n70:         table.insert(lines, { text = l.sha .. \" \" .. l.subject, fg = \"gray\" })\n71:     end\n72: \n73:     -- One \"text\" node per line rather than joining with \"\\n\": this keeps\n74:     -- each line's own colour, which a single content= string cannot carry.\n75:     local children = {}\n76:     for _, spec in ipairs(lines) do\n77:         table.insert(children, {\n78:             type = \"text\",\n79:             content = spec.text,\n80:             fg = spec.fg,\n81:             bold = spec.bold,\n82:             size = { fixed = 1 },\n83:             wrap = false,\n84:         })\n85:     end\n86: \n87:     return {\n88:         type = \"split\",\n89:         direction = \"vertical\",\n90:         children = children,\n91:     }\n92: end\n93: \"#;\n94: \n95: #[cfg(test)]\n96: mod tests {\n97:     use super::*;\n98:     use crate::git::{FileChange, LogEntry};\n99: \n100:     #[test]\n101:     fn state_to_json_none_is_null() {\n102:         assert_eq!(state_to_json(None), serde_json::Value::Null);\n103:     }\n104: \n105:     #[test]\n106:     fn state_to_json_round_trips_fields() {\n107:         let state = GitState {\n108:             branch: Some(\"main\".to_string()),\n109:             ahead: 2,\n110:             behind: 0,\n111:             changes: vec![FileChange {\n112:                 status: \"M\".to_string(),\n113:                 path: \"a.rs\".to_string(),\n114:             }],\n115:             recent: vec![LogEntry {\n116:                 sha: \"abc1234\".to_string(),\n117:                 subject: \"fix\".to_string(),\n118:             }],\n119:         };\n120:         let json = state_to_json(Some(&state));\n121:         assert_eq!(json[\"branch\"], \"main\");\n122:         assert_eq!(json[\"ahead\"], 2);\n123:         assert_eq!(json[\"changes\"][0][\"status\"], \"M\");\n124:         assert_eq!(json[\"recent\"][0][\"sha\"], \"abc1234\");\n125:     }\n126: \n127:     /// The Lua source must at least be syntactically valid and define\n128:     /// `render`, callable with both the \"not a repo\" (nil) and a real state\n129:     /// shape — this is what a config author would hit first if this string\n130:     /// ever had a typo, so it must be caught by `cargo test`, not by running\n131:     /// the plugin live inside a TUI session.\n132:     #[test]\n133:     fn lua_source_parses_and_render_handles_both_shapes() {\n134:         let lua = mlua::Lua::new();\n135:         lua.load(LUA_SOURCE).exec().expect(\"LUA_SOURCE must parse\");\n136: \n137:         let render: mlua::Function = lua.globals().get(\"render\").unwrap();\n138: \n139:         // Nil state (not a repo).\n140:         let widget: mlua::Table = render.call(mlua::Value::Nil).unwrap();\n141:         assert_eq!(widget.get::<String>(\"type\").unwrap(), \"text\");\n142: \n143:         // Real state, round-tripped through the same JSON this plugin sends.\n144:         let state = GitState {\n145:             branch: Some(\"main\".to_string()),\n146:             ahead: 1,\n147:             behind: 0,\n148:             changes: vec![FileChange {\n149:                 status: \"M\".to_string(),\n150:                 path: \"a.rs\".to_string(),\n151:             }],\n152:             recent: vec![LogEntry {\n153:                 sha: \"abc1234\".to_string(),\n154:                 subject: \"fix\".to_string(),\n155:             }],\n156:         };\n157:         let json = state_to_json(Some(&state));\n158:         let lua_value = json_to_lua_for_test(&lua, &json);\n159:         let widget: mlua::Table = render.call(lua_value).unwrap();\n160:         assert_eq!(widget.get::<String>(\"type\").unwrap(), \"split\");\n161:     }\n162: \n163:     /// Minimal JSON->Lua conversion for the test above. Deliberately NOT the\n164:     /// production path (that lives host-side in kn9t-tui's plugin_ui.rs) —\n165:     /// this only needs to support the flat shape state_to_json produces.\n166:     fn json_to_lua_for_test(lua: &mlua::Lua, v: &serde_json::Value) -> mlua::Value {\n167:         match v {\n168:             serde_json::Value::Null => mlua::Value::Nil,\n169:             serde_json::Value::Bool(b) => mlua::Value::Boolean(*b),\n170:             serde_json::Value::Number(n) => mlua::Value::Number(n.as_f64().unwrap_or(0.0)),\n171:             serde_json::Value::String(s) => mlua::Value::String(lua.create_string(s).unwrap()),\n172:             serde_json::Value::Array(arr) => {\n173:                 let t = lua.create_table().unwrap();\n174:                 for (i, item) in arr.iter().enumerate() {\n175:                     t.set(i + 1, json_to_lua_for_test(lua, item)).unwrap();\n176:                 }\n177:                 mlua::Value::Table(t)\n178:             }\n179:             serde_json::Value::Object(map) => {\n180:                 let t = lua.create_table().unwrap();\n181:                 for (k, val) in map {\n182:                     t.set(k.as_str(), json_to_lua_for_test(lua, val)).unwrap();\n183:                 }\n184:                 mlua::Value::Table(t)\n185:             }\n186:         }\n187:     }\n188: }",
