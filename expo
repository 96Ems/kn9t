              "text": "1: //! Generator for `API.md` — the human-readable contract.\n2: //!\n3: //! Derived entirely from `schema/http.json` + `schema/plugin.json` (ADR-0005).\n4: //! API.md must **never** be hand-edited again; `scripts/check-schema.sh` fails on\n5: //! drift. The server is authoritative for behavior (R-TUI-012); this document is\n6: //! the schema, rendered.\n7: \n8: use std::path::Path;\n9: \n10: use serde_json::Value;\n11: \n12: use crate::schema::{markdown_type, properties, required, routes, sse_events};\n13: \n14: const HEADER: &str = \"# kn9t Server HTTP API Reference\n15: \n16: > **GENERATED FILE — do not edit by hand.** Regenerate with\n17: > `cargo run -p xtask -- generate`. Source of truth: `schema/http.json` +\n18: > `schema/plugin.json` (ADR-0005). The server binary is the authoritative\n19: > implementation (R-TUI-012); this document is derived from the schema and cannot\n20: > drift from it. Any mismatch is a bug in the schema or the server, not in this file.\n21: \n22: ---\n23: \n24: ## 1. Connection Basics\n25: \n26: | Item | Detail |\n27: |------|--------|\n28: | **Port** | Read from `~/.kn9t/port` (plain integer, one line) |\n29: | **Token** | Read from `~/.kn9t/token` (plain string, one line) |\n30: | **Auth** | `Authorization: Bearer <token>` — required on every request |\n31: | **Origin** | Requests with an `Origin` header are rejected with `403`. Browser `fetch()` is blocked by design. Use a native HTTP client. |\n32: | **Base URL** | `http://127.0.0.1:<port>` |\n33: \n34: ---\n35: \n36: ## 2. HTTP Routes\n37: \n38: \";\n39: \n40: const ERRORS_TABLE: &str = \"| Code | Meaning |\\n\\\n41:     |------|---------|\\n\\\n42:     | `400` | Bad request / invalid body (malformed JSON, unknown field, bad enum value) |\\n\\\n43:     | `401` | Missing or invalid Bearer token |\\n\\\n44:     | `403` | Origin header present, or wrong lease holder |\\n\\\n45:     | `404` | Resource not found |\\n\\\n46:     | `409` | Conflict (lease held by another client, or turn already running) |\\n\\\n47:     | `500` | Internal server error |\\n\";\n48: \n49: const LEASE_PROSE: &str =\n50:     \"Write operations require an **X-Lease** header: the holder token minted by\\n\\\n51:     `POST /session/{id}/lease`. Routes marked **lease required** below return `409` without it.\\n\\\n52:     `POST /approve` additionally needs `X-Lease-Session: <session_id>`.\\n\";\n53: \n54: pub fn write(root: &Path, http: &Value, plugin: &Value) -> Result<(), String> {\n55:     let out = generate(http, plugin)?;\n56:     let path = root.join(\"API.md\");\n57:     std::fs::write(&path, out.as_bytes()).map_err(|e| format!(\"write API.md: {e}\"))?;\n58:     Ok(())\n59: }\n60: \n61: pub fn generate(http: &Value, plugin: &Value) -> Result<String, String> {\n62:     let mut s = String::new();\n63:     s.push_str(HEADER);\n64:     s.push_str(LEASE_PROSE);\n65:     s.push('\\n');\n66: \n67:     // ── routes ──\n68:     let mut last_method = \"\";\n69:     let mut first = true;\n70:     for route in routes(http) {\n71:         if route.method != last_method {\n72:             if !first {\n73:                 s.push_str(\"\\n---\\n\");\n74:             }\n75:             last_method = route.method;\n76:         }\n77:         first = false;\n78:         s.push_str(&emit_route(&route));\n79:         s.push('\\n');\n80:     }\n81: \n82:     // ── sse ──\n83:     s.push_str(\"---\\n\\n## 3. SSE Event Stream\\n\\n\");\n84:     s.push_str(&emit_sse(http));\n85:     s.push('\\n');\n86: \n87:     // ── errors ──\n88:     s.push_str(\"---\\n\\n## 4. Error Response Format\\n\\n\");\n89:     s.push_str(\n90:         \"All error responses return JSON: `{ \\\"error\\\": \\\"code\\\", \\\"message\\\": \\\"...\\\" }`.\\n\\n\",\n91:     );\n92:     s.push_str(ERRORS_TABLE);\n93:     s.push('\\n');\n94: \n95:     // ── plugin protocol ──\n96:     s.push_str(\"---\\n\\n## 5. Plugin Protocol Wire Format (NdJSON)\\n\\n\");\n97:     s.push_str(&emit_plugin(plugin));\n98: \n99:     // ── common types ──\n100:     s.push_str(\"---\\n\\n## 6. Common Types\\n\\n\");\n101:     s.push_str(COMMON_TYPES);\n102: \n103:     Ok(s)\n104: }\n105: \n106: fn emit_route(route: &crate::schema::Route<'_>) -> String {\n107:     let mut s = String::new();\n108:     let title = route.description.unwrap_or(\"(no description in schema)\");\n109:     s.push_str(&format!(\n110:         \"### `{} {}` — {title}\\n\\n\",\n111:         route.method, route.path\n112:     ));\n113:     s.push_str(&format!(\n114:         \"- **Lease required:** {}\\n\",\n115:         if route.lease { \"yes\" } else { \"no\" }\n116:     ));\n117: \n118:     if let Some(q) = route.query {\n119:         if !q.is_null() {\n120:             s.push_str(\"\\n**Query params**\\n\\n\");\n121:             s.push_str(&query_params_table(q));\n122:         }\n123:     }\n124: \n125:     match route.request_object() {\n126:         Some(body) => {\n127:             s.push_str(\"\\n**Request body**\\n\\n\");\n128:             s.push_str(&props_table(body, false));\n129:         }\n130:         None => match route.request {\n131:             Some(r) if r.get(\"type\").and_then(|t| t.as_str()) == Some(\"string\") => {\n132:                 s.push_str(\"\\n**Request body:** raw bytes (see `contentEncoding`).\\n\");\n133:             }\n134:             _ => {\n135:                 s.push_str(\"\\n**Request body:** none\\n\");\n136:             }\n137:         },\n138:     }\n139: \n140:     match route.response_object() {\n141:         Some(body) => {\n142:             s.push_str(\"\\n**Response `200`**\\n\\n\");\n143:             s.push_str(&props_table(body, true));\n144:         }\n145:         None => match route.response {\n146:             Some(r) if r.get(\"type\").and_then(|t| t.as_str()) == Some(\"string\") => {\n147:                 s.push_str(\"\\n**Response `200`:** raw bytes.\\n\");\n148:             }\n149:             _ => {}\n150:         },\n151:     }\n152:     s\n153: }\n154: \n155: /// Render a route-level `query` map (`{since: {...}, group_by: {...}}`) as a table.\n156: fn query_params_table(query: &Value) -> String {\n157:     let Some(map) = query.as_object() else {\n158:         return String::new();\n159:     };\n160:     let mut s = String::new();\n161:     s.push_str(\"| Param | Type | Description |\\n|-------|------|-------------|\\n\");\n162:     for (key, prop) in map.iter() {\n163:         let ty = markdown_type(prop);\n164:         let desc = prop\n165:             .get(\"description\")\n166:             .and_then(|d| d.as_str())\n167:             .unwrap_or(\"\");\n168:         if let Some(en) = prop.get(\"enum\").and_then(|e| e.as_array()) {\n169:             let vals: Vec<&str> = en.iter().filter_map(|v| v.as_str()).collect();\n170:             s.push_str(&format!(\n171:                 \"| `{key}` | {ty} | {desc} (values: {}) |\\n\",\n172:                 vals.join(\" \\\\| \")\n173:             ));\n174:         } else {\n175:             s.push_str(&format!(\"| `{key}` | {ty} | {desc} |\\n\"));\n176:         }\n177:     }\n178:     s.push('\\n');\n179:     s\n180: }\n181: \n182: /// Render an object subschema as a markdown property table.\n183: fn props_table(body: &Value, is_response: bool) -> String {\n184:     let req = required(body);\n185:     let props = properties(body);\n186:     if props.is_empty() {\n187:         return \"Opaque object (`type: object`, no schema properties).\\n\".to_string();\n188:     }\n189:     let mut s = String::new();\n190:     if is_response {\n191:         s.push_str(\"| Field | Type | Description |\\n|-------|------|-------------|\\n\");\n192:     } else {\n193:         s.push_str(\"| Field | Type | Required | Description |\\n|-------|------|----------|-------------|\\n\");\n194:     }\n195:     for (key, prop) in props {\n196:         let ty = markdown_type(prop);\n197:         let desc = prop\n198:             .get(\"description\")\n199:             .and_then(|d| d.as_str())\n200:             .unwrap_or(\"\");\n201:         if is_response {\n202:             s.push_str(&format!(\"| `{key}` | {ty} | {desc} |\\n\"));\n203:         } else {\n204:             let required_flag = if req.iter().any(|r| r == &key) {\n205:                 \"yes\"\n206:             } else {\n207:                 \"no\"\n208:             };\n209:             s.push_str(&format!(\"| `{key}` | {ty} | {required_flag} | {desc} |\\n\"));\n210:         }\n211:     }\n212:     s.push('\\n');\n213:     s\n214: }\n215: \n216: fn emit_sse(http: &Value) -> String {\n217:     let mut s = String::new();\n218:     s.push_str(\n219:         \"### `GET /session/{id}/events?from=<seq>&lease=<holder>` — Subscribe to events\\n\\n\",\n220:     );\n221:     s.push_str(\n222:         \"Opens a persistent `text/event-stream`. No lease required to *subscribe*. Query param\\n\",\n223:     );\n224:     s.push_str(\n225:         \"`from` is the replay cursor: pass `0` for full history, or `last_seen_seq` on reconnect\\n\",\n226:     );\n227:     s.push_str(\"to resume without replaying already-processed events (exact gap-free dedup on the server).\\n\\n\");\n228:     s.push_str(\n229:         \"**Wire format:** each frame is `event: <kind>\\\\ndata: <json>\\\\n\\\\n`. The `kind` is\\n\",\n230:     );\n231:     s.push_str(\n232:         \"**snake_case** (AGENTS.md §12) and matches the `kind` discriminator inside `data`.\\n\\n\",\n233:     );\n234:     s.push_str(\"**Query params**\\n\\n\");\n235:     s.push_str(\"| Param | Type | Required | Description |\\n\");\n236:     s.push_str(\"|-------|------|----------|-------------|\\n\");\n237:     s.push_str(\"| `from` | u64 | no | Replay cursor; durable events with `seq > from` are replayed, then the stream goes live. Default `0` (full history). |\\n\");\n238:     s.push_str(\"| `lease` | string | no | Lease holder token from `POST /session/{id}/lease`. If given, **this stream owns the lease**: see \\\"Keeping a write lease alive\\\" below. |\\n\\n\");\n239:     s.push_str(\"**Keeping a write lease alive (client authors: read this).**\\n\\n\");\n240:     s.push_str(\n241:         \"The write lease has an idle timeout (default 5 min, DESIGN §12.6). Only *successful\\n\",\n242:     );\n243:     s.push_str(\"writes* (`prompt`/`steer`/`abort`/`model`/`compact`) refresh it. A client that holds the\\n\");\n244:     s.push_str(\n245:         \"lease but only reads — i.e. sits on the event stream without sending anything — would\\n\",\n246:     );\n247:     s.push_str(\n248:         \"otherwise idle-lose its lease after the timeout, and its **next `prompt` would 409\\n\",\n249:     );\n250:     s.push_str(\"`session_busy`** even though the same client is still connected.\\n\\n\");\n251:     s.push_str(\n252:         \"To avoid this, pass your lease holder as `?lease=<holder>` when you open the stream.\\n\",\n253:     );\n254:     s.push_str(\"The server then treats this SSE connection as the *owner* of that lease:\\n\\n\");\n255:     s.push_str(\n256:         \"- **Kept warm while connected** — every heartbeat (`: keepalive`) refreshes the lease's\\n\",\n257:     );\n258:     s.push_str(\"  `last_active`, so the idle timer never fires for an attached reader.\\n\");\n259:     s.push_str(\n260:         \"- **Released on disconnect** — when the stream ends (client close, network drop, or\\n\",\n261:     );\n262:     s.push_str(\"  server heartbeat write failure), the server releases that lease. On reconnect you must\\n\");\n263:     s.push_str(\"  re-acquire it via `POST /session/{id}/lease` (and pass the new holder to the new stream).\\n\\n\");\n264:     s.push_str(\"Recommended client sequence: `POST /lease` → open `GET …/events?from=<seq>&lease=<holder>`\\n\");\n265:     s.push_str(\"→ `POST …/prompt` with `X-Lease: <holder>`. Keep the stream open for the whole session.\\n\\n\");\n266:     s.push_str(\"**Errors:** `404` session not found.\\n\\n\");\n267: \n268:     let events = sse_events(http);\n269:     s.push_str(\"#### Event catalogue\\n\\n\");\n270:     s.push_str(\"| kind | Fields | Durable |\\n|------|--------|---------|\\n\");\n271:     for ev in &events {\n272:         let durable = ev.fields.iter().any(|(k, _)| k == \"seq\");\n273:         let fields: Vec<String> = ev\n274:             .fields\n275:             .iter()\n276:             .map(|(k, t)| format!(\"`{k}: {}`\", sse_md_type(t)))\n277:             .collect();\n278:         s.push_str(&format!(\n279:             \"| `{}` | {} | {} |\\n\",\n280:             ev.kind,\n281:             fields.join(\", \"),\n282:             if durable { \"yes\" } else { \"no\" }\n283:         ));\n284:     }\n285:     s.push('\\n');\n286:     s.push_str(\n287:         \"**Durable events** carry `seq` and are replayed on reconnect. **Transient events** are\\n\",\n288:     );\n289:     s.push_str(\"live only. Clients track the highest durable `seq` seen and reconnect with `from=last+1`.\\n\");\n290:     s\n291: }\n292: \n293: /// Display type for an SSE field (compact schema strings).\n294: fn sse_md_type(t: &str) -> String {\n295:     match t {\n296:         \"u64\" | \"u32\" => t.to_string(),\n297:         \"string\" => \"string\".to_string(),\n298:         \"number\" => \"number\".to_string(),\n299:         \"bool\" => \"bool\".to_string(),\n300:         \"Message\" => \"Message\".to_string(),\n301:         \"ModelRef\" => \"ModelRef\".to_string(),\n302:         \"SeqRange\" => \"SeqRange\".to_string(),\n303:         \"Tokens\" => \"Tokens\".to_string(),\n304:         \"Value\" => \"object\".to_string(),\n305:         other => other.to_string(),\n306:     }\n307: }\n308: \n309: fn emit_plugin(plugin: &Value) -> String {\n310:     let mut s = String::new();\n311:     s.push_str(\n312:         \"All plugin communication is newline-delimited JSON (NdJSON) over stdin/stdout.\\n\\n\",\n313:     );\n314:     s.push_str(\"### 5.1 JSON convention\\n\\n\");\n315:     s.push_str(\n316:         \"**All JSON uses `snake_case`** for field names and enum variants (AGENTS.md §12).\\n\\n\",\n317:     );\n318: \n319:     s.push_str(\"### 5.2 Host → Plugin messages\\n\\n\");\n320:     s.push_str(&msg_table(plugin.get(\"host_to_plugin\")));\n321:     s.push_str(\"### 5.3 Plugin → Host messages\\n\\n\");\n322:     s.push_str(&msg_table(plugin.get(\"plugin_to_host\")));\n323: \n324:     if let Some(defs) = plugin.get(\"definitions\").and_then(|d| d.as_object()) {\n325:         for (i, (name, subschema)) in defs.iter().enumerate() {\n326:             s.push_str(&format!(\"### 5.{} `{name}`\\n\\n\", 4 + i));\n327:             s.push_str(&props_table(subschema, true));\n328:         }\n329:     }\n330: \n331:     s.push_str(\"### 5.5 Handshake sequence\\n\\n\");\n332:     s.push_str(HANDSHAKE_PROSE);\n333:     s.push_str(\"\\n### 5.6 Flattened body fields\\n\\n\");\n334:     s.push_str(FLATTEN_PROSE);\n335:     s.push_str(\"\\n### 5.7 Lifecycle hooks\\n\\n\");\n336:     s.push_str(&hooks_table(plugin));\n337:     s\n338: }\n339: \n340: /// Hook table with the payload column read from `schema/plugin.json`.\n341: ///\n342: /// Only the reply/composition/failure columns are prose: they describe host\n343: /// behaviour that is not expressed in the schema. The payload column used to be\n344: /// prose too and had silently drifted — `cwd` was added to several hooks in the\n345: /// schema while the table still advertised `{session_id}` alone, which is\n346: /// exactly the kind of mismatch this file's header promises cannot happen.\n347: fn hooks_table(plugin: &Value) -> String {\n348:     // (hook, reply, composition, failure posture) — the non-schema columns.\n349:     const SEMANTICS: &[(&str, &str, &str, &str)] = &[\n350:         (\n351:             \"before_tool_call\",\n352:             r#\"`{action: \"allow\"\\|\"deny\"\\|\"replace\", ...}`\"#,\n353:             \"First-deny-wins\",\n354:             \"**Deny** (fail closed)\",\n355:         ),\n356:         (\n357:             \"after_tool_call\",\n358:             r#\"`{action: \"keep\"\\|\"replace\", content}`\"#,\n359:             \"Pipeline\",\n360:             \"Keep original\",\n361:         ),\n362:         (\n363:             \"before_request\",\n364:             r#\"`{action: \"keep\"\\|\"replace\", messages}`\"#,\n365:             \"Pipeline\",\n366:             \"Use original\",\n367:         ),\n368:         (\n369:             \"should_stop_after_turn\",\n370:             r#\"`{action: \"continue\"\\|\"stop\"}`\"#,\n371:             \"Any-says-stop\",\n372:             \"Continue\",\n373:         ),\n374:         (\n375:             \"prepare_next_turn\",\n376:             \"`{model?, thinking?}`\",\n377:             \"Pipeline\",\n378:             \"No change\",\n379:         ),\n380:         (\"get_steering\", \"`{messages}`\", \"Concat\", \"Empty\"),\n381:         (\"get_followup\", \"`{messages}`\", \"Concat\", \"Empty\"),\n382:         (\n383:             \"get_api_key\",\n384:             \"`{key}`\",\n385:             \"First non-null\",\n386:             \"Fall back to config\",\n387:         ),\n388:     ];\n389: \n390:     let hooks = plugin.get(\"hook_payloads\").and_then(|h| h.as_object());\n391: \n392:     let mut s = String::new();\n393:     s.push_str(HOOKS_INTRO);\n394:     s.push_str(\"\\n| Hook | Payload | Reply | Composition | Failure posture |\\n\");\n395:     s.push_str(\"|------|---------|-------|-------------|-----------------|\\n\");\n396: \n397:     for (name, reply, composition, failure) in SEMANTICS {\n398:         // Fall back to the hook name only if the schema lacks the entry, so a\n399:         // missing definition is visible rather than silently rendering blank.\n400:         let payload = hooks\n401:             .and_then(|h| h.get(*name))\n402:             .map(|sub| {\n403:                 let names: Vec<String> = properties(sub)\n404:                     .iter()\n405:                     .map(|(field, _)| field.clone())\n406:                     .collect();\n407:                 format!(\"`{{{}}}`\", names.join(\", \"))\n408:             })\n409:             .unwrap_or_else(|| \"*(not in schema)*\".to_string());\n410:         s.push_str(&format!(\n411:             \"| `{name}` | {payload} | {reply} | {composition} | {failure} |\\n\"\n412:         ));\n413:     }\n414: \n415:     s.push_str(HOOKS_OUTRO);\n416:     s\n417: }\n418: \n419: fn msg_table(obj: Option<&Value>) -> String {\n420:     let Some(map) = obj.and_then(|o| o.as_object()) else {\n421:         return String::new();\n422:     };\n423:     let mut s = String::new();\n424:     s.push_str(\"| `t` | Fields | Notes |\\n|-----|--------|-------|\\n\");\n425:     for (name, subschema) in map {\n426:         let props = properties(subschema);\n427:         let names: Vec<String> = props\n428:             .iter()\n429:             .filter(|(k, _)| k != \"t\")\n430:             .map(|(k, p)| format!(\"`{k}: {}`\", markdown_type(p)))\n431:             .collect();\n432:         let notes = subschema\n433:             .get(\"description\")\n434:             .and_then(|d| d.as_str())\n435:             .unwrap_or(\"\");\n436:         s.push_str(&format!(\n437:             \"| `{}` | {} | {notes} |\\n\",\n438:             name.to_lowercase(),\n439:             names.join(\", \")\n440:         ));\n441:     }\n442:     s.push('\\n');\n443:     s\n444: }\n445: \n446: const HANDSHAKE_PROSE: &str = r#\"```\n447: Host   →  {\"t\": \"hello\", \"proto\": 1, \"kn9t\": \"0.1.0\"}\n448: Plugin →  {\"t\": \"hello\", \"name\": \"my-plugin\", \"hooks\": [...], \"tools\": [...], \"capabilities\": [...], \"events\": [...]}\n449: ```\n450: \n451: `proto` is the protocol version (currently `1`); `kn9t` is the server version string.\n452: A plugin declares itself with `name` (unique id), `hooks`, `tools` (see `ToolSpec`),\n453: `capabilities` (e.g. `[\"streaming\", \"cancelable\"]`), and the `events` it wants.\n454: \"#;\n455: \n456: const FLATTEN_PROSE: &str = r#\"The protocol wraps hook **bodies** with `#[serde(flatten)]` — body fields sit at the\n457: **same level** as `t` and `id`, NOT nested under a `\"body\"` key:\n458: \n459: ```json\n460: // ✅ correct — body fields flattened:\n461: {\"t\": \"result\", \"id\": 7, \"messages\": [...]}\n462: {\"t\": \"done\",  \"id\": 42, \"content\": [...], \"is_error\": false}\n463: \n464: // ❌ wrong — nested body:\n465: {\"t\": \"result\", \"id\": 7, \"body\": {\"messages\": [...]}}\n466: ```\n467: \n468: This applies to `result`, `chunk`, and `done` plugin→host messages.\n469: \"#;\n470: \n471: const HOOKS_INTRO: &str = r#\"Plugins subscribe to lifecycle hooks in the hello message. Each hook invocation is\n472: `{\"t\": \"hook\", \"id\": <int>, \"hook\": \"<name>\", \"payload\": {...}}`; the plugin answers with\n473: `{\"t\": \"result\", \"id\": <same>, ...flattened reply fields}`.\n474: \"#;\n475: \n476: const HOOKS_OUTRO: &str = r#\"\n477: **All hooks include `session_id`**, so plugins can keep per-session state.\n478: \n479: Hooks whose payload includes `cwd` also carry the session's working directory.\n480: This is what lets a plugin bootstrap per-session background work (a poller, a\n481: file watcher) from a real lifecycle signal - `get_steering` fires every turn -\n482: instead of shipping a dummy agent-callable tool purely to obtain a host channel.\n483: In the Rust SDK, override `PluginHook::call_with_ctx` to receive a\n484: `HookCtx { host, session_id, cwd }`; plain `call` remains available for hooks\n485: that only transform their payload.\n486: \"#;\n487: \n488: const COMMON_TYPES: &str = r#\"### Message\n489: \n490: ```json\n491: { \"id\": \"string\", \"role\": \"user\" | \"assistant\" | \"tool\" | \"system\", \"content\": [Content], \"silent\": bool? }\n492: ```\n493: \n494: `silent: true` messages are persisted and sent to the LLM but **not displayed** in clients.\n495: \n496: ### Content (union, discriminated by `type`)\n497: \n498: | `type` | Additional fields |\n499: |--------|-------------------|\n500: | `\"text\"` | `text: string` |\n501: | `\"tool_call\"` | `id: string`, `name: string`, `args_json: string` |\n502: | `\"tool_result\"` | `id: string`, `content: Content[]`, `is_error: bool` |\n503: | `\"thinking\"` | `text: string` |\n504: | `\"image\"` | `sha256: string`, `mime: string` |\n505: \n506: ### Tokens\n507: \n508: ```json\n509: { \"input\": u64, \"output\": u64, \"cache_read\": u64, \"cache_write\": u64, \"reasoning\": u64 }\n510: ```\n511: \n512: ### ModelRef\n513: \n514: ```json\n515: { \"provider\": \"string\", \"id\": \"string\" }\n516: ```\n517: \"#;",
              "type": "text"
            }
          ],
