                "text": "1: //! Keybind system — R-TUI-160.\n2: //!\n3: //! All navigation uses a modifier key (Ctrl by default, configurable).\n4: //! This ensures all letters are available for typing in the input.\n5: \n6: use std::collections::HashMap;\n7: \n8: use crossterm::event::{KeyCode, KeyEvent, KeyModifiers};\n9: \n10: /// Actions that can be bound to keys.\n11: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n12: pub enum Action {\n13:     // Core\n14:     Quit,  // Ctrl+C or Ctrl+Q\n15:     Abort, // Escape\n16:     Help,  // Ctrl+P (command palette)\n17:     Send,  // Enter (steers if streaming, prompts if idle)\n18:     Queue, // Shift+Enter: queue message for post-idle send (unlike steer)\n19:     Paste, // Ctrl+V: paste from system clipboard\n20: \n21:     // Scrolling\n22:     ScrollUp,     // Ctrl+Up or PageUp\n23:     ScrollDown,   // Ctrl+Down or PageDown\n24:     ScrollTop,    // Ctrl+Home\n25:     ScrollBottom, // Ctrl+End\n26: \n27:     // Message navigation\n28:     PrevMessage, // Ctrl+K\n29:     NextMessage, // Ctrl+J\n30: \n31:     // Session picker (Ctrl+B). Sidebars are defined in tui.lua, so there is no\n32:     // built-in sidebar action: a config toggles its own panel in Lua.\n33:     SessionPicker,\n34: \n35:     // Sessions\n36:     NewSession, // Ctrl+N\n37: \n38:     // Tool mode\n39:     ToolMode, // Ctrl+T: enter/exit tool mode\n40: \n41:     // Undo/Redo\n42:     Undo, // Ctrl+Z: undo input change\n43:     Redo, // Ctrl+Y or Ctrl+Shift+Z: redo input change\n44: \n45:     // Kill ring (Emacs-style)\n46:     KillToEnd,   // Ctrl+K: kill to end of line\n47:     KillToStart, // Ctrl+U: kill to start of line\n48:     KillWord,    // Ctrl+W: kill word backward\n49:     Yank,        // Ctrl+Y: yank (paste from kill ring)\n50:     YankPop,     // Alt+Y: cycle through kill ring after yank\n51: \n52:     // Thinking blocks\n53:     ToggleThinking, // Ctrl+E: toggle thinking block collapse\n54: \n55:     // Search\n56:     OpenSearch,  // Ctrl+F: open search bar\n57:     CloseSearch, // Escape: close search bar (in search mode)\n58:     NextMatch,   // Enter: next match (in search mode)\n59:     PrevMatch,   // Shift+Enter: previous match (in search mode)\n60:     ToggleRegex, // Alt+R: toggle regex mode (in search mode)\n61:     ToggleCase,  // Alt+C: toggle case sensitivity (in search mode)\n62: \n63:     // Word navigation\n64:     WordLeft,        // Ctrl+Left: move cursor to previous word\n65:     WordRight,       // Ctrl+Right: move cursor to next word\n66:     DeleteWordLeft,  // Ctrl+Backspace: delete word backward\n67:     DeleteWordRight, // Ctrl+Delete: delete word forward\n68: \n69:     // Semantic navigation (jump between user/assistant messages)\n70:     PrevUserMessage, // Ctrl+Up: jump to previous user message\n71:     NextUserMessage, // Ctrl+Down: jump to next user message\n72: \n73:     // Model cycling (quick switch without picker)\n74:     CycleModelNext, // F2: next model\n75:     CycleModelPrev, // Shift+F2: previous model\n76: \n77:     // Diff viewer. Exposed as actions rather than hardcoded keys so a config can\n78:     // rebind them; `default_tui.lua` maps the historical j/k/[/]/n/p/u/f/b set.\n79:     //\n80:     // `OpenDiff` is what actually populates `App.diff_viewer` (runs `git diff`\n81:     // and parses it) — everything else here only navigates/closes a viewer\n82:     // that already exists. Placing `{type=\"native\", view=\"diff\"}` in a\n83:     // render_ui() layout draws the viewer if one is open; it does not open\n84:     // one. A config that only flips its own MAIN_VIEW state and never calls\n85:     // this action gets a blank pane, which is exactly the bug this fixes.\n86:     OpenDiff,\n87:     DiffNextHunk,\n88:     DiffPrevHunk,\n89:     DiffNextFile,\n90:     DiffPrevFile,\n91:     DiffCursorDown,\n92:     DiffCursorUp,\n93:     DiffToggleSplit,\n94:     DiffToggleFullscreen,\n95:     DiffToggleTree,\n96:     DiffComment,\n97:     DiffClose,\n98: