 format_for_agent_reports_clean_tree() {\n100:         let state = GitState {\n101:             branch: Some(\"main\".to_string()),\n102:             ahead: 0,\n103:             behind: 0,\n104:             changes: vec![],\n105:             recent: vec![],\n106:         };\n107:         let out = format_for_agent(&state);\n108:         assert!(out.contains(\"branch: main\"));\n109:         assert!(out.contains(\"working tree clean\"));\n110:     }\n111: \n112:     #[test]\n113:     fn format_for_agent_lists_changes_and_ahead_behind() {\n114:         let state = GitState {\n115:             branch: Some(\"feature\".to_string()),\n116:             ahead: 3,\n117:             behind: 1,\n118:             changes: vec![FileChange {\n119:                 status: \"M\".to_string(),\n120:                 path: \"src/main.rs\".to_string(),\n121:             }],\n122:             recent: vec![LogEntry {\n123:                 sha: \"abc1234\".to_string(),\n124:                 subject: \"wip\".to_string(),\n125:             }],\n126:         };\n127:         let out = format_for_agent(&state);\n128:         assert!(out.contains(\"(+3 -1)\"));\n129:         assert!(out.contains(\"M src/main.rs\"));\n130:         assert!(out.contains(\"abc1234 wip\"));\n131:     }\n132: \n133:     #[test]\n134:     fn spec_has_no_required_arguments() {\n135:         let spec = GitStatus.spec();\n136:         assert_eq!(spec.name, \"git_status\");\n137:         // An agent should be able to call this with `{}` — no args needed.\n138:         assert_eq!(spec.schema[\"properties\"].as_object().unwrap().len(), 0);\n139:     }\n140: }",
