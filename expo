              "text": "1: //! Lua click handlers — widget `id`s bound to Lua callbacks.\n2: //!\n3: //! A widget carrying `id=\"...\"` in its Lua table gets wrapped in\n4: //! [`crate::lua::widgets::Widget::Clickable`]; `kn9t.on_click(id, function(x, y,\n5: //! button) ... end)` registers what runs when that rect is clicked.\n6: //!\n7: //! Coordinates passed to the handler are local to the widget's own rect\n8: //! (`mouse_x - rect.x`), not screen-absolute — a list at column 40 should not\n9: //! have to know its own screen position to find out which row was clicked.\n10: //!\n11: //! Dispatch order mirrors floats-over-base-layout: the caller (`App::handle_click`)\n12: //! is expected to check floating panels before the base `render_ui` tree, same as\n13: //! rendering paints floats last (on top). A handler returning `false` falls\n14: //! through to Rust's existing hardcoded click handling (tool cards, diff\n15: //! viewer), matching how `kn9t.map` lets a keymap extend rather than replace.\n16: \n17: use std::collections::HashMap;\n18: \n19: use mlua::{Function, Lua, RegistryKey, Result as LuaResult, Table, Value};\n20: \n21: /// Registry of Lua click handlers, keyed by widget `id`.\n22: #[derive(Debug, Default)]\n23: pub struct ClickRegistry {\n24:     handlers: HashMap<String, RegistryKey>,\n25: }\n26: \n27: impl ClickRegistry {\n28:     pub fn new() -> Self {\n29:         Self::default()\n30:     }\n31: \n32:     pub fn len(&self) -> usize {\n33:         self.handlers.len()\n34:     }\n35: \n36:     pub fn is_empty(&self) -> bool {\n37:         self.handlers.is_empty()\n38:     }\n39: \n40:     /// Whether any Lua handler is bound to `id`.\n41:     pub fn has(&self, id: &str) -> bool {\n42:         self.handlers.contains_key(id)\n43:     }\n44: \n45:     /// Bind `id` to a Lua function, replacing any previous binding.\n46:     pub fn insert(&mut self, id: String, func_key: RegistryKey) {\n47:         self.handlers.insert(id, func_key);\n48:     }\n49: \n50:     pub fn remove(&mut self, id: &str) {\n51:         self.handlers.remove(id);\n52:     }\n53: \n54:     /// Invoke the handler bound to `id` with rect-local coordinates.\n55:     ///\n56:     /// Returns `true` when the click was consumed. A handler that returns\n57:     /// `false` (or errors) is treated as *not* consumed, so Rust's existing\n58:     /// click handling (tool cards, diff viewer) still gets a chance — the same\n59:     /// \"extend, don't replace\" contract `KeymapRegistry::dispatch` has.\n60:     pub fn dispatch(&self, lua: &Lua, id: &str, local_x: u16, local_y: u16, button: &str) -> bool {\n61:         let Some(reg_key) = self.handlers.get(id) else {\n62:             return false;\n63:         };\n64:         let Ok(func) = lua.registry_value::<Function>(reg_key) else {\n65:             return false;\n66:         };\n67:         match func.call::<Value>((local_x, local_y, button)) {\n68:             Ok(Value::Boolean(false)) => false,\n69:             Ok(_) => true,\n70:             Err(e) => {\n71:                 crate::log!(\"Lua on_click '{}' error: {}\", id, e);\n72:                 false\n73:             }\n74:         }\n75:     }\n76: }\n77: \n78: /// Install `kn9t.on_click` / `kn9t.remove_click` into the Lua environment.\n79: ///\n80: /// Registrations are queued in `kn9t._pending_clicks`, drained by\n81: /// [`drain_pending_clicks`] — the same registry-then-drain idiom as\n82: /// `kn9t.map`/`kn9t.unmap`, so a hot-reload replaces handlers instead of\n83: /// accumulating duplicates.\n84: pub fn install_click_api(lua: &Lua) -> LuaResult<()> {\n85:     let globals = lua.globals();\n86:     let kn9t: Table = globals\n87:         .get(\"kn9t\")\n88:         .unwrap_or_else(|_| lua.create_table().unwrap());\n89: \n90:     let pending = lua.create_table()?;\n91:     kn9t.set(\"_pending_clicks\", pending)?;\n92: \n93:     let on_click_fn = lua.create_function(|lua, (id, func): (String, Function)| {\n94:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n95:         let pending: Table = kn9t.get(\"_pending_clicks\")?;\n96:         pending.set(id, func)?;\n97:         Ok(())\n98:     })?;\n99:     kn9t.set(\"on_click\", on_click_fn)?;\n100: \n101:     let remove_click_fn = lua.create_function(|lua, id: String| {\n102:         let kn9t: Table = lua.globals().get(\"kn9t\")?;\n103:         let pending: Table = kn9t.get(\"_pending_clicks\")?;\n104:         // false is the tombstone: distinguishes \"unbind\" from \"never mentioned\".\n105:         pending.set(id, false)?;\n106:         Ok(())\n107:     })?;\n108:     kn9t.set(\"remove_click\", remove_click_fn)?;\n109: \n110:     globals.set(\"kn9t\", kn9t)?;\n111:     Ok(())\n112: }\n113: \n114: /// Apply queued `kn9t.on_click` / `kn9t.remove_click` calls to `registry`.\n115: ///\n116: /// Returns the number of handlers applied (added or removed).\n117: pub fn drain_pending_clicks(lua: &Lua, registry: &mut ClickRegistry) -> LuaResult<usize> {\n118:     let globals = lua.globals();\n119:     let Ok(kn9t) = globals.get::<Table>(\"kn9t\") else {\n120:         return Ok(0);\n121:     };\n122:     let Ok(pending) = kn9t.get::<Table>(\"_pending_clicks\") else {\n123:         return Ok(0);\n124:     };\n125: \n126:     let mut applied = 0;\n127:     let mut seen: Vec<String> = Vec::new();\n128: \n129:     for pair in pending.pairs::<String, Value>() {\n130:         let (id, value) = pair?;\n131:         seen.push(id.clone());\n132: \n133:         match value {\n134:             Value::Function(f) => {\n135:                 registry.insert(id, lua.create_registry_value(f)?);\n136:                 applied += 1;\n137:             }\n138:             Value::Boolean(false) => {\n139:                 registry.remove(&id);\n140:                 applied += 1;\n141:             }\n142:             _ => {\n143:                 crate::log!(\"Lua on_click '{}': expected function, got other value\", id);\n144:             }\n145:         }\n146:     }\n147: \n148:     for id in