cused and (\\\" \\\" .. title .. \\\" - Esc to release \\\")\\n                                    or (\\\" \\\" .. title .. \\\" \\\"),\\n                border = true,\\n                border_fg = is_focused and \\\"cyan\\\" or nil,\\n                size = { fixed = rows },\\n                child = { type = \\\"plugin\\\", plugin = spec.name },\\n            })\\n        end\\n    end\\n    return out\\nend\", \"old_string\": \"local function plugin_view_children(width)\\n    local names = (kn9t.state and kn9t.state.plugin_views) or {}\\n    local focused = (kn9t.state and kn9t.state.focused_plugin) or \\\"\\\"\\n    local out = {}\\n    for _, name in ipairs(names) do\\n        local is_focused = (name == focused)\\n        table.insert(out, {\\n            type = \\\"box\\\",\\n            -- Spell out how to reach and leave the panel: these keys are the\\n            -- plugin's own, so nothing here can list them per-plugin.\\n            title = is_focused and (\\\" \\\" .. name .. \\\" - Esc to release \\\")\\n                                or (\\\" \\\" .. name .. \\\" \\\"),\\n            border = true,\\n            border_fg = is_focused and \\\"cyan\\\" or nil,\\n            size = { fixed = is_focused and PLUGIN_VIEW_ROWS_FOCUSED or PLUGIN_VIEW_ROWS },\\n            child = { type = \\\"plugin\\\", plugin = name },\\n        })\\n    end\\n    return out\\nend\", \"path\": \"crates/kn9t-tui/assets/default_tui.lua\"}",
