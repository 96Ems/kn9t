                "text": "1: -- 60_commands.lua — palette/slash commands and keybinds this layout adds.\n2: --\n3: -- Main-view switching is command/slash-driven (Q4/Q13 in the design\n4: -- session), not a persistent tab bar: kn9t.register_command with slash=\"view\"\n5: -- reaches both the command palette (Ctrl+P) and typing \"/view diff\".\n6: \n7: kn9t.register_command({\n8:     id = \"view_chat\",\n9:     label = \"View: Chat\",\n10:     description = \"Show the conversation in the main pane\",\n11:     category = \"View\",\n12:     slash = \"view\",\n13:     handler = function(args)\n14:         TUI.MAIN_VIEW = \"chat\"\n15:         kn9t.action(\"diff_close\")\n16:         kn9t.invalidate()\n17:     end,\n18: })\n19: \n20: kn9t.register_command({\n21:     id = \"view_diff\",\n22:     label = \"View: Diff\",\n23:     description = \"Show the diff viewer in the main pane\",\n24:     category = \"View\",\n25:     slash = \"view\",\n26:     handler = function(args)\n27:         TUI.MAIN_VIEW = \"diff\"\n28:         kn9t.action(\"open_diff\")\n29:         kn9t.invalidate()\n30:     end,\n31: })\n32: \n33: -- How each tool's card renders. Returning nil falls back to the built-in\n34: -- mapping, so only the tools you care about need an entry. This is the hook\n35: -- that lets a plugin tool pick a renderer — the choice used to be hardcoded\n36: -- in Rust, so only the four built-in tools could ever be styled.\n37: --\n38: --   \"diff\"      show diff/progress lines      (edit, write)\n39: --   \"summary\"   header summary only           (read)\n40: --   \"streaming\" live progress, then output    (bash)\n41: --   \"output\"    command output                (everything else)\n42: local TOOL_MODES = {\n43:     edit  = \"diff\",\n44:     write = \"diff\",\n45:     read  = \"summary\",\n46:     bash  = \"streaming\",\n47: }\n48: \n49: function tool_mode(name)\n50:     return TOOL_MODES[name]\n51: end\n52: \n53: -- Sidebar toggles, independent per side (Q12b in the design session).\n54: kn9t.map(\"F1\", function()\n55:     TUI.show.left_sidebar = not TUI.show.left_sidebar\n56:     kn9t.invalidate()\n57: end)\n58: kn9t.map(\"F2\", function()\n59:     TUI.show.right_sidebar = not TUI.show.right_sidebar\n60:     kn9t.invalidate()\n61: end)\n62: \n63: -- Quick left-sidebar source switch without going through the tab bar click.\n64: kn9t.map(\"F3\", function()\n65:     TUI.LEFT_TAB = (TUI.LEFT_TAB == \"git\") and \"sessions\" or \"git\"\n66:     kn9t.invalidate()\n67: end)\n68: \n69: -- Direct jump to the diff view / back to chat, alongside the /view command.\n70: -- open_diff actually runs `git diff` and populates the viewer — placing\n71: -- {type=\"native\", view=\"diff\"} in 90_render.lua only DRAWS an existing\n72: -- viewer, it does not open one.\n73: --\n74: -- IMPORTANT: while App.diff_viewer is Some(...), Rust's handle_key() routes\n75: -- EVERY key (including this F10 binding) into the diff viewer's own input\n76: -- handler FIRST — see app.rs's handle_key, \"diff_viewer.is_some() -> return\".\n77: -- That handler happens to still ask this same kn9t.map(\"F10\", ...) handler\n78: -- first (it re-dispatches through dispatch_keymap), so this code does run —\n79: -- but TUI.MAIN_VIEW alone controls nothing on the Rust side. Only\n80: -- kn9t.action(\"diff_close\") actually clears App.diff_viewer (via\n81: -- Action::DiffClose -> close_diff_viewer -> diff_viewer.take()). Without\n82: -- this, \"F10 to go back to chat\" only changed Lua state while Rust kept\n83: -- routing every key into the still-open viewer forever, until Esc.\n84: kn9t.map(\"F10\", function()\n85:     if TUI.MAIN_VIEW == \"chat\" then\n86:         TUI.MAIN_VIEW = \"diff\"\n87:         kn9t.action(\"open_diff\")\n88:     else\n89:         TUI.MAIN_VIEW = \"chat\"\n90:         kn9t.action(\"diff_close\")\n91:     end\n92:     kn9t.invalidate()\n93: end)\n94: \n95: kn9t.map(\"F7\", function() kn9t.action(\"scroll_top\") end)\n96: kn9t.map(\"F8\", function() kn9t.action(\"scroll_bottom\") end)",
