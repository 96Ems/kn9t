            ahead: 1,\n147:             behind: 0,\n148:             changes: vec![FileChange {\n149:                 status: \"M\".to_string(),\n150:                 path: \"a.rs\".to_string(),\n151:             }],\n152:             recent: vec![LogEntry {\n153:                 sha: \"abc1234\".to_string(),\n154:                 subject: \"fix\".to_string(),\n155:             }],\n156:         };\n157:         let json = state_to_json(Some(&state));\n158:         let lua_value = json_to_lua_for_test(&lua, &json);\n159:         let widget: mlua::Table = render.call(lua_value).unwrap();\n160:         assert_eq!(widget.get::<String>(\"type\").unwrap(), \"split\");\n161:     }\n162: \n163:     /// Minimal JSON->Lua conversion for the test above. Deliberately NOT the\n164:     /// production path (that lives host-side in kn9t-tui's plugin_ui.rs) —\n165:     /// this only needs to support the flat shape state_to_json produces.\n166:     fn json_to_lua_for_test(lua: &mlua::Lua, v: &serde_json::Value) -> mlua::Value {\n167:         match v {\n168:             serde_json::Value::Null => mlua::Value::Nil,\n169:             serde_json::Value::Bool(b) => mlua::Value::Boolean(*b),\n170:             serde_json::Value::Number(n) => mlua::Value::Number(n.as_f64().unwrap_or(0.0)),\n171:             serde_json::Value::String(s) => mlua::Value::String(lua.create_string(s).unwrap()),\n172:             serde_json::Value::Array(arr) => {\n173:                 let t = lua.create_table().unwrap();\n174:                 for (i, item) in arr.iter().enumerate() {\n175:                     t.set(i + 1, json_to_lua_for_test(lua, item)).unwrap();\n176:                 }\n177:                 mlua::Value::Table(t)\n178:             }\n179:             serde_json::Value::Object(map) => {\n180:                 let t = lua.create_table().unwrap();\n181:                 for (k, val) in map {\n182:                     t.set(k.as_str(), json_to_lua_for_test(lua, val)).unwrap();\n183:                 }\n184:                 mlua::Value::Table(t)\n185:             }\n186:         }\n187:     }\n188: }",
