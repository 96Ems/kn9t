\"tool_call\"` | `id: string`, `name: string`, `args_json: string` |\n790: | `\"tool_result\"` | `id: string`, `content: Content[]`, `is_error: bool` |\n791: | `\"thinking\"` | `text: string` |\n792: | `\"image\"` | `sha256: string`, `mime: string` |\n793: ",
