th, height)                      │\\n│      local lines = {}                                                      │\\n│      for i, file in ipairs(panel:get_files()) do                           │\\n│          table.insert(lines, {                                             │\\n│              text = file.path,                                             │\\n│              style = panel:get_file_status(i),                             │\\n│              on_click = function()                                         │\\n│                  diff.panel:set_current_file(i)                            │\\n│              end                                                           │\\n│          })                                                                │\\n│      end                                                                  │\\n│      return lines                                                          │\\n│  end                                                                       │\\n│                                                                             │\\n│  function diff.render_content(panel, width, height)                        │\\n│      -- Render diff lines with custom colors, fonts, etc.                  │\\n│      -- Full control over visual presentation!                             │\\n│  end                                                                       │\\n│                                                                             │\\n│  function diff.render_ui()                                                 │\\n│      if not diff.panel then return nil end                                │\\n│      return {                                                              │\\n│          type = 'vbox',                                                   │\\n│          children = {                                                      │\\n│              diff.render_file_tree(...),                                   │\\n│              diff.render_content(...),                                     │\\n│              diff.render_footer(...),                                      │\\n│              diff.render_comment_overlay(...),                             │\\n│          }                                                                │\\n│      }                                                                    │\\n│  end                                                                       │\\n│                                                                             │\\n└─────────────────────────────────────────────────────────────────────────────┘\\n```\\n\\n---\\n\\n## Data Flow: Opening a Diff\\n\\n### Current (Rust only)\\n```\\nUser presses Ctrl+D (or calls :diff)\\n  ├─ execute_action(Action::OpenDiff)\\n  │  └─ open_git_diff()\\n  │     ├─ bash: git diff HEAD → text\\n  │     ├─ Parse unified diff → DiffFile/DiffHunk/DiffLine\\n  │     └─ DiffViewer::new(files) → app.diff_viewer\\n  │\\nUser presses [\\n  ├─ handle_key() → check diff_viewer.is_some()\\n  ├─ handle_overlay_key() → match '[' ⟹ Action::DiffPrevHunk\\n  ├─ execute_action() → viewer.prev_hunk()\\n  └─ Rust modifies viewer state\\n  \\nrender_chat()\\n  ├─ Check if fullscreen diff\\n  ├─ viewer.render(area, buf, theme) [HUGE METHOD]\\n  │  ├─ Render file tree with colors\\n  │  ├─ Render diff content with syntax highlighting\\n  │  ├─ Render footer\\n  │  └─ Render comment overlay if commenting\\n  └─ Frame displays buffer\\n```\\n\\n### New (Plugin + Lua)\\n```\\nUser presses Ctrl+D (or calls :diff)\\n  ├─ execute_action(Action::OpenDiff)\\n  │  └─ open_git_diff()\\n  │     ├─ bash: git diff HEAD → text\\n  │     └─ kn9t_plugin_diff::parse_git_diff(text)\\n  │        └─ Parse unified diff → DiffFile/DiffHunk/DiffLine\\n  │           → Arc<Mutex<DiffPanel>> → app.diff_panel\\n  │\\nUser presses 'n' (in diff)\\n  ├─ handle_key() → check diff_panel.is_some()\\n  ├─ dispatch_keymap(\\\"diff:next_file\\\") [checked first, always]\\n