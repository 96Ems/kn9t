                "text": "1: //! Schema navigation helpers shared by all generators.\n2: //!\n3: //! All iteration is over the schema's own ordering (serde_json is built here with\n4: //! `preserve_order` — a generator-only feature, see `xtask/Cargo.toml`), so every\n5: //! output is deterministic and byte-stable across runs.\n6: \n7: use serde_json::{Map, Value};\n8: \n9: /// Rust struct name for a route's **request** type. Only POST routes with a JSON\n10: /// object body appear here; a route missing from this map is a schema bug that the\n11: /// generator surfaces loudly instead of silently emitting nothing.\n12: pub fn req_name_for_path(path: &str) -> Option<&'static str> {\n13:     match path {\n14:         \"/session\" => Some(\"CreateSessionReq\"),\n15:         \"/session/{id}/fork\" => Some(\"ForkReq\"),\n16:         \"/session/{id}/prompt\" => Some(\"PromptReq\"),\n17:         \"/session/{id}/steer\" => Some(\"SteerReq\"),\n18:         \"/session/{id}/model\" => Some(\"SetModelReq\"),\n19:         \"/session/{id}/tools\" => Some(\"SetToolsReq\"),\n20:         \"/session/{id}/rename\" => Some(\"RenameReq\"),\n21:         \"/session/{id}/compact\" => Some(\"CompactReq\"),\n22:         \"/approve\" => Some(\"ApproveReq\"),\n23:         \"/ui-respond\" => Some(\"UiRespondReq\"),\n24:         \"/plugin/load\" => Some(\"PluginLoadReq\"),\n25:         _ => None,\n26:     }\n27: }\n28: \n29: /// A route entry as a lightweight struct (method, path, lease, and the request /\n30: /// response / query subschemas).\n31: pub struct Route<'a> {\n32:     pub method: &'a str,\n33:     pub path: &'a str,\n34:     pub lease: bool,\n35:     pub description: Option<&'a str>,\n36:     pub request: Option<&'a Value>,\n37:     pub response: Option<&'a Value>,\n38:     pub query: Option<&'a Value>,\n39: }\n40: \n41: impl<'a> Route<'a> {\n42:     /// POST routes whose request consumes a JSON object body (the typed set).\n43:     pub fn request_object(&self) -> Option<&'a Value> {\n44:         let req = self.request?;\n45:         if req.get(\"type\").and_then(|t| t.as_str()) == Some(\"object\") {\n46:             Some(req)\n47:         } else {\n48:             None\n49:         }\n50:     }\n51: \n52:     /// Routes with a JSON object response (leaf types like raw binary are skipped).\n53:     pub fn response_object(&self) -> Option<&'a Value> {\n54:         let resp = self.response?;\n55:         if resp.get(\"type\").and_then(|t| t.as_str()) == Some(\"object\") {\n56:             Some(resp)\n57:         } else {\n58:             None\n59:         }\n60:     }\n61: }\n62: \n63: /// The ordered `routes` array from `schema/http.json`.\n64: pub fn routes(http: &Value) -> Vec<Route<'_>> {\n65:     http.get(\"routes\")\n66:         .and_then(|r| r.as_array())\n67:         .map(|arr| {\n68:             arr.iter()\n69:                 .map(|r| Route {\n70:                     method: r.get(\"method\").and_then(|m| m.as_str()).unwrap_or(\"\"),\n71:                     path: r.get(\"path\").and_then(|p| p.as_str()).unwrap_or(\"\"),\n72:                     lease: r.get(\"lease\").and_then(|l| l.as_bool()).unwrap_or(false),\n73:                     description: r.get(\"description\").and_then(|d| d.as_str()),\n74:                     request: r.get(\"request\"),\n75:                     response: r.get(\"response\"),\n76:                     query: r.get(\"query\"),\n77:                 })\n78:                 .collect()\n79:         })\n80:         .unwrap_or_default()\n81: }\n82: \n83: /// Ordered property map of an object subschema.\n84: pub fn properties<'a>(obj: &'a Value) -> Vec<(String, &'a Value)> {\n85:     obj.get(\"properties\")\n86:         .and_then(|p| p.as_object())\n87:         .map(props_in_order)\n88:         .unwrap_or_default()\n89: }\n90: \n91: fn props_in_order(map: &Map<String, Value>) -> Vec<(String, &Value)> {\n92:     map.iter().map(|(k, v)| (k.clone(), v)).collect()\n93: }\n94: \n95: /// The `required` array of an object subschema (order preserved).\n96: pub fn required(obj: &Value) -> Vec<String> {\n97:     obj.get(\"required\")\n98:         .and_then(|r| r.as_array())\n99:         .map(|a| {\n100:             a.iter()\n101:                 .filter_map(|x| x.as_str().map(|s| s.to_string()))\n102:                 .collect()\n103:         })\n104:         .unwrap_or_default()\n105: }\n106: \n107: /// The well-known `{provider, id}` model-reference shape.\n108: pub fn is_model_ref(prop: &Value) -> bool {\n109:     let map = match prop.get(\"properties\").and_then(|p| p.as_object()) {\n110:         Some(m) => m,\n111:         None => return false,\n112:     };\n113:     if map.len() != 2 {\n114:         return false;\n115:     }\n116:     let str_prop = |v: Option<&Value>| matches!(v, Some(v) if v.get(\"type\").and_then(|t| t.as_str()) == Some(\"string\"));\n117:     str_prop(map.get(\"provider\")) && str_prop(map.get(\"id\"))\n118: }\n119: \n120: /// Map a JSON Schema type to a Rust type. `model_ref_ty` names the type generated\n121: /// for the well-known `{provider, id}` object shape. `nullable` (a `[\"type\",\"null\"]`\n122: /// union) yields `Option<T>`.\n123: pub fn rust_type(prop: &Value, model_ref_ty: &str) -> String {\n124:     let mut nullable = false;\n125:     let mut prim: Option<&str> = None;\n126:     match prop.get(\"type\") {\n127:         Some(t) if t.is_string() => prim = t.as_str(),\n128:         Some(t) if t.is_array() => {\n129:             for member in t.as_array().into_iter().flatten() {\n130:                 match member.as_str() {\n131:                     Some(\"null\") => nullable = true,\n132:                     Some(other) => prim = Some(other),\n133:                     None => {}\n134:                 }\n135:             }\n136:         }\n137:         _ => {}\n138:     }\n139: \n140:     let base = match prim {\n141:         Some(\"string\") => \"String\".to_string(),\n142:         Some(\"integer\") => \"u64\".to_string(),\n143:         Some(\"number\") => \"f64\".to_string(),\n144:         Some(\"boolean\") => \"bool\".to_string(),\n145:         Some(\"array\") => {\n146:             let item_ty = prop\n147:                 .get(\"items\")\n148:                 .and_then(|i| i.get(\"type\"))\n149:                 .and_then(|t| t.as_str())\n150:                 .unwrap_or(\"object\");\n151:             match item_ty {\n152:                 \"string\" => \"Vec<String>\".to_string(),\n153:                 _ => \"Vec<serde_json::Value>\".to_string(),\n154:             }\n155:         }\n156:         Some(\"object\") if is_model_ref(prop) => model_ref_ty.to_string(),\n157:         Some(\"object\") => \"serde_json::Value\".to_string(),\n158:         _ => \"serde_json::Value\".to_string(),\n159:     };\n160: \n161:     if nullable {\n162:         format!(\"Option<{base}>\")\n163:     } else {\n164:         base\n165:     }\n166: }\n167: \n168: /// Rust type for a property, honoring requiredness: an optional non-nullable field\n169: /// is wrapped in `Option`, everything else passes through `rust_type`.\n170: pub fn prop_type(prop: &Value, required: &[String], key: &str, model_ref_ty: &str) -> String {\n171:     let ty = rust_type(prop, model_ref_ty);\n172:     if required.iter().any(|r| r.as_str() == key) || ty.starts_with(\"Option<\") {\n173:         ty\n174:     } else {\n175:         format!(\"Option<{ty}>\")\n176:     }\n177: }\n178: \n179: /// Human-readable type for API.md tables (e.g. `string`, `u64`, `string[]`, `ModelRef`).\n180: /// Nullable unions (schema `[\"type\",\"null\"]`) render as `inner \\| null`.\n181: pub fn markdown_type(prop: &Value) -> String {\n182:     let t = rust_type(prop, \"ModelRef\");\n183:     let compact = match t.as_str() {\n184:         \"String\" => \"string\".to_string(),\n185:         \"u64\" => \"u64\".to_string(),\n186:         \"f64\" => \"number\".to_string(),\n187:         \"bool\" => \"bool\".to_string(),\n188:         \"Vec<String>\" => \"string[]\".to_string(),\n189:         \"Vec<serde_json::Value>\" => \"object[]\".to_string(),\n190:         \"serde_json::Value\" => \"object\".to_string(),\n191:         other => other.to_string(),\n192:     };\n193:     if let Some(inner) = compact.strip_prefix(\"Option<\") {\n194:         format!(\"{} \\\\| null\", inner.trim_end_matches('>'))\n195:     } else {\n196:         compact\n197:     }\n198: }\n199: \n200: /// The SSE event catalogue (`schema/http.json` → `sse.events`): kind + field map.\n201: pub struct SseEvent<'a> {\n202:     pub kind: &'a str,\n203:     pub fields: Vec<(String, String)>,\n204: }\n205: \n206: pub fn sse_events(http: &Value) -> Vec<SseEvent<'_>> {\n207:     http.get(\"sse\")\n208:         .and_then(|s| s.get(\"events\"))\n209:         .and_then(|e| e.as_array())\n210:         .map(|arr| {\n211:             arr.iter()\n212:                 .filter_map(|ev| {\n213:                     let kind = ev.get(\"kind\").and_then(|k| k.as_str())?;\n214:                     let fields = ev\n215:                         .as_object()\n216:                         .map(|o| {\n217:                             o.iter()\n218:                                 .filter(|(k, _)| k.as_str() != \"kind\")\n219:                                 .map(|(k, v)| {\n220:                                     (k.clone(), v.as_str().unwrap_or(\"Value\").to_string())\n221:                                 })\n222:                                 .collect()\n223:                         })\n224:                         .unwrap_or_default();\n225:                     Some(SseEvent { kind, fields })\n226:                 })\n227:                 .collect()\n228:         })\n229:         .unwrap_or_default()\n230: }\n231: \n232: /// `message_appended` → `MessageAppended` (CamelCase variant name).\n233: pub fn to_camel(snake: &str) -> String {\n234:     let mut out = String::with_capacity(snake.len());\n235:     let mut upper = true;\n236:     for c in snake.chars() {\n237:         if c == '_' {\n238:             upper = true;\n239:         } else if upper {\n240:             out.extend(c.to_uppercase());\n241:             upper = false;\n242:         } else {\n243:             out.push(c);\n244:         }\n245:     }\n246:     out\n247: }",
