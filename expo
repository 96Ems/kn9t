(no sessions yet)\",\n95:             fg = C.dim,\n96:             size = { flex = 1 },\n97:         }\n98:     end\n99: \n100:     local items = {}\n101:     for i, s in ipairs(sessions) do\n102:         local id = \"session_row_\" .. s.id\n103:         if not registered_session_clicks[id] then\n104:             kn9t.on_click(id, session_row_click(s.id))\n105:             registered_session_clicks[id] = true\n106:         end\n107:         local name = s.name or s.id\n108:         if #name > inner_w - 2 then name = name:sub(1, inner_w - 3) .. \"~\" end\n109:         table.insert(items, {\n110:             id = id,\n111:             type = \"text\",\n112:             content = (s.is_current and \"> \" or \"  \") .. name,\n113:             fg = s.is_current and C.accent or C.value,\n114:         })\n115:     end\n116: \n117:     -- A plain list widget cannot carry a per-row id today (id wraps a whole\n118:     -- widget node, and \"list\" is one node with N items) — so each row is its\n119:     -- own clickable text node in a vertical split instead. This costs one\n120:     -- widget per session rather than one list; acceptable for a sidebar of\n121:     -- realistically a few dozen entries at most.\n122:     return {\n123:         type = \"split\",\n124:         direction = \"vertical\",\n125:         size = { flex = 1 },\n126:         children = items,\n127:     }\n128: end\n129: \n130: function TUI.build_sidebar_left(height)\n131:     local inner_w = 32\n132: \n133:     local body\n134:     if TUI.LEFT_TAB == \"git\" then\n135:         body = git_view(inner_w, height)\n136:     else\n137:         body = session_list(inner_w, height)\n138:     end\n139: \n140:     return {\n141:         type = \"box\",\n142:         border = \"plain\",\n143:         border_fg = C.dim,\n144:         child = {\n145:             type = \"split\",\n146:             direction = \"vertical\",\n147:             children = { tab_bar(inner_w), body },\n148:         },\n149:     }\n150: end"