{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kn9t Plugin Protocol (v1)",
  "description": "Host ↔ Plugin NdJSON, ToolSpec, ProviderDecl, hooks, host_api request/reply. SDK and host JSON compatible.",
  "host_to_plugin": {
    "Hello": {
      "type": "object",
      "properties": {
        "t": { "const": "hello" },
        "proto": { "type": "integer", "const": 1 },
        "kn9t": { "type": "string" }
      },
      "required": ["t", "proto", "kn9t"],
      "additionalProperties": false
    },
    "Hook": {
      "type": "object",
      "properties": {
        "t": { "const": "hook" },
        "id": { "type": "integer" },
        "hook": { "type": "string" },
        "payload": { "type": "object" }
      },
      "required": ["t", "id", "hook", "payload"]
    },
    "Cancel": { "type": "object", "properties": { "t": { "const": "cancel" }, "id": { "type": "integer" } }, "required": ["t", "id"] },
    "Shutdown": { "type": "object", "properties": { "t": { "const": "shutdown" } }, "required": ["t"] },
    "ApiResult": {
      "type": "object",
      "properties": {
        "t": { "const": "api_result" },
        "id": { "type": "integer" },
        "ok": { "type": "boolean" },
        "result": { "type": "object" },
        "error": { "type": "string" }
      },
      "required": ["t", "id", "ok"],
      "additionalProperties": false
    }
  },
  "plugin_to_host": {
    "Hello": {
      "type": "object",
      "properties": {
        "t": { "const": "hello" },
        "name": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "hooks": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "$ref": "#/definitions/ToolSpec" } },
        "provider": { "$ref": "#/definitions/ProviderDecl" },
        "events": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["t", "name"],
      "additionalProperties": false
    },
    "Result": { "type": "object", "properties": { "t": { "const": "result" }, "id": { "type": "integer" } }, "required": ["t", "id"] },
    "Chunk": { "type": "object", "properties": { "t": { "const": "chunk" }, "id": { "type": "integer" } }, "required": ["t", "id"] },
    "Done": { "type": "object", "properties": { "t": { "const": "done" }, "id": { "type": "integer" } }, "required": ["t", "id"] },
    "Request": {
      "type": "object",
      "description": "Plugin → host API request (host_api capability). Ops: provider_complete, session_read, tool_execute, session_fork, session_prompt, tool_list, ui_directive, ui_register_lua, ui_set_state, ui_clear. TUI display is plugin-supplied Lua: send the source once with ui_register_lua {source} (defines render(state) returning a widget tree), then push data with ui_set_state {state} (arbitrary JSON) and tear down with ui_clear. The host does not interpret the Lua or the state; the widget vocabulary belongs to the TUI. A registered view is interactive, not render-only: inside its chunk it may call kn9t.on_click(id, fn) to handle clicks on widgets carrying that id, kn9t.on_key(key, fn) to handle keys while the view holds focus, and kn9t.insert_input(text) to append to the user's prompt. Handlers are keyed per plugin, so two plugins may reuse the same id or key without colliding; a handler returning false falls through to the host. Keys only reach a focused view (Esc blurs), so a plugin cannot swallow global keybinds.",
      "properties": {
        "t": { "const": "request" },
        "id": { "type": "integer" },
        "op": { "type": "string" },
        "payload": { "type": "object" }
      },
      "required": ["t", "id", "op", "payload"],
      "additionalProperties": false
    }
  },
  "hook_payloads": {
    "before_tool_call": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "description": "Session ID" },
        "tool": { "type": "string", "description": "Tool name" },
        "args": { "type": "object", "description": "Tool arguments" },
        "cwd": { "type": "string", "description": "Working directory of the session" }
      },
      "required": ["session_id", "tool", "args", "cwd"]
    },
    "after_tool_call": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "tool": { "type": "string" },
        "args": { "type": "object" },
        "cwd": { "type": "string", "description": "Working directory of the session" },
        "result": { "type": "array", "items": { "$ref": "#/definitions/Content" } }
      },
      "required": ["session_id", "tool", "args", "cwd", "result"]
    },
    "before_request": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "messages": { "type": "array", "items": { "$ref": "#/definitions/Message" } },
        "model": { "$ref": "#/definitions/ModelRef" },
        "system": { "type": "string" }
      },
      "required": ["session_id", "messages", "model"]
    },
    "should_stop_after_turn": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "stop": { "type": "string", "enum": ["end_turn", "max_tokens", "stop_sequence", "tool_use"] },
        "usage": { "$ref": "#/definitions/Usage" },
        "turn": { "type": "integer" }
      },
      "required": ["session_id", "stop", "usage", "turn"]
    },
    "prepare_next_turn": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "stop": { "type": "string", "enum": ["end_turn", "max_tokens", "stop_sequence", "tool_use"] },
        "usage": { "$ref": "#/definitions/Usage" }
      },
      "required": ["session_id", "stop", "usage"]
    },
    "get_steering": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "description": "Session ID" },
        "cwd": { "type": "string", "description": "Working directory of the session" }
      },
      "required": ["session_id", "cwd"]
    },
    "get_followup": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string", "description": "Session ID" },
        "cwd": { "type": "string", "description": "Working directory of the session" }
      },
      "required": ["session_id", "cwd"]
    },
    "get_api_key": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "provider": { "type": "string" }
      },
      "required": ["session_id", "provider"]
    },
    "tool_call": {
      "type": "object",
      "properties": {
        "session_id": { "type": "string" },
        "tool": { "type": "string" },
        "args": { "type": "object" },
        "cwd": { "type": "string", "description": "Working directory of the session" }
      },
      "required": ["session_id", "tool", "args", "cwd"]
    }
  },
  "definitions": {
    "ToolSpec": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "schema": { "type": "object" },
        "parallel_safe": { "type": "boolean", "default": false },
        "hidden": { "type": "boolean", "default": false },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "kind": { "type": "string", "enum": ["shell", "fs_read", "fs_write", "network"] }
            },
            "required": ["field", "kind"],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": ["name", "description", "schema"],
      "additionalProperties": false
    },
    "ProviderDecl": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "models": { "type": "array", "items": { "$ref": "#/definitions/ModelDecl" } }
      },
      "required": ["id", "models"]
    },
    "ModelDecl": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ctx_window": { "type": "integer" },
        "price": { "type": "object", "properties": { "input": { "type": "number" }, "output": { "type": "number" }, "cache_read": { "type": "number" }, "cache_write": { "type": "number" } } }
      },
      "required": ["id", "ctx_window"]
    },
    "Content": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["type"]
    },
    "Message": {
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "array", "items": { "$ref": "#/definitions/Content" } },
        "silent": { "type": "boolean", "default": false }
      },
      "required": ["role", "content"]
    },
    "ModelRef": {
      "type": "object",
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" }
      },
      "required": ["provider", "id"]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input": { "type": "integer" },
        "output": { "type": "integer" },
        "cache_read": { "type": "integer" },
        "cache_write": { "type": "integer" }
      },
      "required": ["input", "output", "cache_read", "cache_write"]
    }
  }
}
